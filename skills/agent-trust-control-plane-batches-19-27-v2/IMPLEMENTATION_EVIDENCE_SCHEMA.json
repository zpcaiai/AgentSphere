{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-trust-implementation-status-v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "batch", "status", "commit", "evidence"],
  "properties": {
    "project": {
      "const": "agent-trust-control-plane"
    },
    "batch": {
      "type": "string",
      "pattern": "^(0[1-9]|[12][0-9]|3[0-6])$"
    },
    "status": {
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "BLOCKED",
        "EVIDENCE_VERIFIED"
      ]
    },
    "commit": {
      "type": "string",
      "minLength": 7
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command"],
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "status": {
            "enum": ["PASS", "FAIL", "SKIP", "NOT_RUN_RESOURCE_FREEZE", "NOT_RUN_EXTERNAL"]
          },
          "kind": {
            "type": "string"
          },
          "result": {
            "type": "string"
          },
          "report": {
            "type": "string"
          }
        },
        "oneOf": [{"required": ["exit_code"]}, {"required": ["status"]}]
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIP",
              "PASS_STATIC",
              "NOT_RUN_RESOURCE_FREEZE",
              "NOT_RUN_EXTERNAL"
            ]
          },
          "evidence_ref": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "historical_external_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_ref", "status"],
        "properties": {
          "evidence_ref": {"type": "string"},
          "status": {"type": "string"}
        }
      }
    },
    "production_eligible": {
      "type": "boolean"
    },
    "current_validation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "status"],
        "properties": {
          "command": {"type": "string"},
          "status": {
            "enum": ["PASS", "FAIL", "SKIP", "NOT_RUN_RESOURCE_FREEZE", "NOT_RUN_EXTERNAL"]
          },
          "tests": {"type": "integer"},
          "migrations": {"type": "integer"}
        }
      }
    },
    "implemented": {
      "type": "array",
      "items": {"type": "string"}
    },
    "unresolved_gates": {
      "type": "array",
      "items": {"type": "string"}
    },
    "verified_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "oneOf": [
    {"required": ["commands", "tests", "unresolved_risks"]},
    {"required": ["current_validation", "implemented", "unresolved_gates"]}
  ]
}
