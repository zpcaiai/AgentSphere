# syntax=docker/dockerfile:1.7
ARG RUST_BUILDER_IMAGE
ARG RUNTIME_BASE_IMAGE
FROM ${RUST_BUILDER_IMAGE} AS build
WORKDIR /workspace
COPY Cargo.toml Cargo.lock ./
COPY rust ./rust
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/workspace/target,sharing=locked \
    cargo build --locked --release --package agent-trust-pack-supply-chain \
      --bin agenttrust-pack-supply-chain-authority && \
    install -D -m 0555 /workspace/target/release/agenttrust-pack-supply-chain-authority \
      /out/agenttrust-pack-supply-chain-authority

FROM ${RUNTIME_BASE_IMAGE}
COPY --from=build /out/agenttrust-pack-supply-chain-authority /usr/local/bin/agenttrust-pack-supply-chain-authority
USER 65532:65532
EXPOSE 8093 9103
ENTRYPOINT ["/usr/local/bin/agenttrust-pack-supply-chain-authority"]
