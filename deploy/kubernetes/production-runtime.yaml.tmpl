apiVersion: apps/v1
kind: Deployment
metadata:
  name: agenttrust-production-runtime
  labels: {app.kubernetes.io/name: agenttrust-production-runtime, app.kubernetes.io/part-of: agenttrust-control-plane}
spec:
  replicas: 3
  revisionHistoryLimit: 10
  strategy: {type: RollingUpdate, rollingUpdate: {maxUnavailable: 0, maxSurge: 1}}
  selector: {matchLabels: {app.kubernetes.io/name: agenttrust-production-runtime}}
  template:
    metadata:
      labels: {app.kubernetes.io/name: agenttrust-production-runtime, app.kubernetes.io/part-of: agenttrust-control-plane}
    spec:
      serviceAccountName: agenttrust-production-runtime
      automountServiceAccountToken: false
      securityContext: {runAsNonRoot: true, seccompProfile: {type: RuntimeDefault}}
      topologySpreadConstraints:
        - {maxSkew: 1, topologyKey: topology.kubernetes.io/zone, whenUnsatisfiable: DoNotSchedule, labelSelector: {matchLabels: {app.kubernetes.io/name: agenttrust-production-runtime}}}
      containers:
        - name: runtime
          image: "@@PRODUCTION_RUNTIME_IMAGE@@"
          imagePullPolicy: IfNotPresent
          args: ["/etc/agenttrust/production-runtime.json"]
          ports: [{name: management, containerPort: 9090}]
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: ["ALL"]}}
          resources: {requests: {cpu: "500m", memory: "512Mi"}, limits: {cpu: "2", memory: "2Gi"}}
          readinessProbe: {httpGet: {path: /ready, port: management}, periodSeconds: 5, timeoutSeconds: 2, failureThreshold: 3}
          livenessProbe: {httpGet: {path: /health, port: management}, periodSeconds: 10, timeoutSeconds: 2, failureThreshold: 3}
          volumeMounts:
            - {name: runtime-config, mountPath: /etc/agenttrust/production-runtime.json, subPath: production-runtime.json, readOnly: true}
            - {name: workload-secrets, mountPath: /etc/agenttrust, readOnly: true}
            - {name: evidence, mountPath: /var/lib/agenttrust/evidence, readOnly: true}
        - name: mtls-ingress
          image: "@@ENVOY_IMAGE@@"
          args: ["-c", "/etc/envoy/envoy.yaml"]
          ports: [{name: https, containerPort: 8443}]
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: ["ALL"]}}
          resources: {requests: {cpu: "100m", memory: "128Mi"}, limits: {cpu: "1", memory: "512Mi"}}
          volumeMounts:
            - {name: envoy-config, mountPath: /etc/envoy, readOnly: true}
            - {name: workload-secrets, mountPath: /etc/agenttrust, readOnly: true}
      volumes:
        - name: runtime-config
          configMap: {name: agenttrust-production-runtime, optional: false}
        - name: envoy-config
          configMap: {name: agenttrust-mtls-ingress, optional: false}
        - name: workload-secrets
          csi: {driver: secrets-store.csi.k8s.io, readOnly: true, volumeAttributes: {secretProviderClass: agenttrust-production-runtime}}
        - name: evidence
          csi: {driver: evidence.csi.agenttrust.io, readOnly: true, volumeAttributes: {releaseId: "@@RELEASE_ID@@"}}
---
apiVersion: v1
kind: Service
metadata: {name: agenttrust-production-runtime}
spec:
  selector: {app.kubernetes.io/name: agenttrust-production-runtime}
  ports: [{name: https, port: 443, targetPort: https}]
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata: {name: agenttrust-production-runtime}
spec:
  minAvailable: 2
  selector: {matchLabels: {app.kubernetes.io/name: agenttrust-production-runtime}}
---
apiVersion: v1
kind: ServiceAccount
metadata: {name: agenttrust-production-runtime}
automountServiceAccountToken: false
