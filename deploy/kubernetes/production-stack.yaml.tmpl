    app.kubernetes.io/part-of: agenttrust-control-plane
    agenttrust.io/apply-phase: migration
  annotations:
    agenttrust.io/release-id: "@@RELEASE_ID@@"
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 1800
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app.kubernetes.io/name: agenttrust-migrations
        app.kubernetes.io/component: migrations
        app.kubernetes.io/part-of: agenttrust-control-plane
    spec:
      serviceAccountName: agenttrust-migrations
      automountServiceAccountToken: false
      restartPolicy: Never
      enableServiceLinks: false
      securityContext: {runAsNonRoot: true, runAsUser: 65532, runAsGroup: 65532, fsGroup: 65532, fsGroupChangePolicy: OnRootMismatch, seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: migrate
          image: "@@MIGRATION_IMAGE@@"
          args: ["--apply"]
          env:
            - {name: AGENT_TRUST_DATABASE_URL_FILE, value: /var/run/agenttrust/secrets/database-url}
            - {name: AGENT_TRUST_DATABASE_CA_FILE, value: /var/run/agenttrust/secrets/database-ca.pem}
            - {name: AGENT_TRUST_RELEASE_ID, value: "@@RELEASE_ID@@"}
            - {name: AGENT_TRUST_DATABASE_CONNECT_TIMEOUT_SECONDS, value: "10"}
            - {name: AGENT_TRUST_ENTERPRISE_APPLICATION_ROLE, value: "@@ENTERPRISE_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_ORCHESTRATOR_APPLICATION_ROLE, value: "@@ORCHESTRATOR_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_EXECUTION_APPLICATION_ROLE, value: "@@EXECUTION_APPLICATION_ROLE@@"}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: ["ALL"]}}
          resources: {requests: {cpu: 100m, memory: 128Mi}, limits: {cpu: "1", memory: 512Mi}}
          volumeMounts:
            - {name: secrets, mountPath: /var/run/agenttrust/secrets, readOnly: true}
            - {name: tmp, mountPath: /tmp}
      volumes:
        - name: secrets
          csi: {driver: secrets-store.csi.k8s.io, readOnly: true, volumeAttributes: {secretProviderClass: agenttrust-migrations}}
        - {name: tmp, emptyDir: {medium: Memory, sizeLimit: 64Mi}}
