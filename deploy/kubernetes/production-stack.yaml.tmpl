apiVersion: secrets-store.csi.x-k8s.io/v1
kind: SecretProviderClass
metadata:
  name: agenttrust-model-gateway
  labels: {app.kubernetes.io/part-of: agenttrust-control-plane, agenttrust.io/apply-phase: prerequisite}
spec:
  provider: vault
  parameters:
    vaultAddress: "@@VAULT_ADDRESS@@"
    vaultSkipTLSVerify: "false"
    roleName: "@@VAULT_MODEL_GATEWAY_ROLE@@"
    objects: |
      - {objectName: "database-url", secretPath: "@@VAULT_MODEL_GATEWAY_PATH@@", secretKey: "database_url", filePermission: 0o440}
      - {objectName: "database-password", secretPath: "@@VAULT_MODEL_GATEWAY_PATH@@", secretKey: "database_password", filePermission: 0o440}
      - {objectName: "database-ca.pem", secretPath: "@@VAULT_MODEL_GATEWAY_PATH@@", secretKey: "database_ca", filePermission: 0o440}
      - {objectName: "caller-ca.pem", secretPath: "@@VAULT_MODEL_GATEWAY_PATH@@", secretKey: "caller_ca", filePermission: 0o440}
      - {objectName: "server-cert.pem", secretPath: "@@VAULT_MODEL_GATEWAY_PATH@@", secretKey: "server_certificate", filePermission: 0o440}
