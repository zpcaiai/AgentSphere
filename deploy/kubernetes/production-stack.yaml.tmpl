  name: "agenttrust-migrate-@@RELEASE_NAME@@"
  labels:
    app.kubernetes.io/name: agenttrust-migrations
    app.kubernetes.io/component: migrations
    app.kubernetes.io/part-of: agenttrust-control-plane
    agenttrust.io/apply-phase: migration
  annotations:
    agenttrust.io/release-id: "@@RELEASE_ID@@"
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 1800
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app.kubernetes.io/name: agenttrust-migrations
        app.kubernetes.io/component: migrations
        app.kubernetes.io/part-of: agenttrust-control-plane
    spec:
      serviceAccountName: agenttrust-migrations
      automountServiceAccountToken: false
      restartPolicy: Never
      enableServiceLinks: false
      securityContext: {runAsNonRoot: true, runAsUser: 65532, runAsGroup: 65532, fsGroup: 65532, fsGroupChangePolicy: OnRootMismatch, seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: migrate
          image: "@@MIGRATION_IMAGE@@"
          args: ["--apply"]
          env:
            - {name: AGENT_TRUST_DATABASE_URL_FILE, value: /var/run/agenttrust/secrets/database-url}
            - {name: AGENT_TRUST_DATABASE_CA_FILE, value: /var/run/agenttrust/secrets/database-ca.pem}
            - {name: AGENT_TRUST_RELEASE_ID, value: "@@RELEASE_ID@@"}
            - {name: AGENT_TRUST_DATABASE_CONNECT_TIMEOUT_SECONDS, value: "10"}
            - {name: AGENT_TRUST_ENTERPRISE_APPLICATION_ROLE, value: "@@ENTERPRISE_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_ENTERPRISE_AUTHORITY_APPLICATION_ROLE, value: "@@ENTERPRISE_AUTHORITY_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_ORCHESTRATOR_APPLICATION_ROLE, value: "@@ORCHESTRATOR_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_EXECUTION_APPLICATION_ROLE, value: "@@EXECUTION_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_REGISTRY_APPLICATION_ROLE, value: "@@REGISTRY_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_AGENT_REGISTRY_APPLICATION_ROLE, value: "@@AGENT_REGISTRY_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_POLICY_ADMIN_APPLICATION_ROLE, value: "@@POLICY_ADMIN_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_INCIDENT_RELEASE_APPLICATION_ROLE, value: "@@INCIDENT_RELEASE_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_PACK_MARKETPLACE_APPLICATION_ROLE, value: "@@PACK_MARKETPLACE_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_APPROVAL_APPLICATION_ROLE, value: "@@APPROVAL_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_PEP_APPLICATION_ROLE, value: "@@PEP_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_IDENTITY_APPLICATION_ROLE, value: "@@IDENTITY_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_TOOL_PROXY_APPLICATION_ROLE, value: "@@TOOL_PROXY_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_EVIDENCE_APPLICATION_ROLE, value: "@@EVIDENCE_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_AUDIT_APPLICATION_ROLE, value: "@@AUDIT_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_MODEL_GATEWAY_APPLICATION_ROLE, value: "@@MODEL_GATEWAY_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_DATA_GOVERNANCE_APPLICATION_ROLE, value: "@@DATA_GOVERNANCE_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_CONTEXT_GOVERNANCE_APPLICATION_ROLE, value: "@@CONTEXT_GOVERNANCE_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_RUNTIME_ANOMALY_APPLICATION_ROLE, value: "@@RUNTIME_ANOMALY_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_SECURITY_EVALUATION_APPLICATION_ROLE, value: "@@SECURITY_EVALUATION_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_PACK_SUPPLY_CHAIN_APPLICATION_ROLE, value: "@@PACK_SUPPLY_CHAIN_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_DOMAIN_RUNTIME_APPLICATION_ROLE, value: "@@DOMAIN_RUNTIME_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_PLATFORM_SRE_APPLICATION_ROLE, value: "@@PLATFORM_SRE_APPLICATION_ROLE@@"}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: ["ALL"]}}
          resources: {requests: {cpu: 100m, memory: 128Mi}, limits: {cpu: "1", memory: 512Mi}}
          volumeMounts:
            - {name: secrets, mountPath: /var/run/agenttrust/secrets, readOnly: true}
            - {name: tmp, mountPath: /tmp}
      volumes:
        - name: secrets
          csi: {driver: secrets-store.csi.k8s.io, readOnly: true, volumeAttributes: {secretProviderClass: agenttrust-migrations}}
        - {name: tmp, emptyDir: {medium: Memory, sizeLimit: 64Mi}}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: agenttrust-production-runtime
  labels:
    app.kubernetes.io/name: agenttrust-production-runtime
    app.kubernetes.io/component: runtime
    app.kubernetes.io/part-of: agenttrust-control-plane
    agenttrust.io/apply-phase: workload
  annotations: {agenttrust.io/release-id: "@@RELEASE_ID@@"}
spec:
  replicas: 3
  revisionHistoryLimit: 10
  strategy: {type: RollingUpdate, rollingUpdate: {maxUnavailable: 0, maxSurge: 1}}
  selector: {matchLabels: {app.kubernetes.io/name: agenttrust-production-runtime}}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: agenttrust-production-runtime
        app.kubernetes.io/component: runtime
        app.kubernetes.io/part-of: agenttrust-control-plane
      annotations:
        agenttrust.io/release-id: "@@RELEASE_ID@@"
        agenttrust.io/release-digest: "@@RELEASE_DIGEST@@"
    spec:
      serviceAccountName: agenttrust-production-runtime
      automountServiceAccountToken: false
      enableServiceLinks: false
      terminationGracePeriodSeconds: 60
      securityContext: {runAsNonRoot: true, runAsUser: 65532, runAsGroup: 65532, fsGroup: 65532, fsGroupChangePolicy: OnRootMismatch, seccompProfile: {type: RuntimeDefault}}
      topologySpreadConstraints:
        - maxSkew: 1
          minDomains: 3
          topologyKey: topology.kubernetes.io/zone
          whenUnsatisfiable: DoNotSchedule
          labelSelector: {matchLabels: {app.kubernetes.io/name: agenttrust-production-runtime}}
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - topologyKey: kubernetes.io/hostname
              labelSelector: {matchLabels: {app.kubernetes.io/name: agenttrust-production-runtime}}
      initContainers:
        - name: verify-release-evidence
          image: "@@UTILITY_IMAGE@@"
          command: ["/bin/sh", "-ec"]
          args:
            - |
              test "$(cat /evidence/release-id)" = "$RELEASE_ID"
              test -s /evidence/batch-statuses.json
              test -s /evidence/gate-evidence.json
              test -s /evidence/residual-risks.json
              test -s /evidence/exceptions.json
              test -s /evidence/SHA256SUMS
              test "$(sha256sum /evidence/SHA256SUMS | awk '{print $1}')" = "$BUNDLE_DIGEST"
              cd /evidence && sha256sum -c SHA256SUMS
          env:
            - {name: RELEASE_ID, value: "@@RELEASE_ID@@"}
            - {name: BUNDLE_DIGEST, value: "@@EVIDENCE_BUNDLE_DIGEST@@"}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: ["ALL"]}}
          resources: {requests: {cpu: 10m, memory: 16Mi}, limits: {cpu: 100m, memory: 64Mi}}
          volumeMounts: [{name: evidence, mountPath: /evidence, readOnly: true}]
      containers:
        - name: runtime
          image: "@@RUNTIME_IMAGE@@"
          imagePullPolicy: IfNotPresent
          args: ["/etc/agenttrust/config/production-runtime.json"]
          ports:
            - {name: data, containerPort: 8080}
            - {name: management, containerPort: 9090}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: ["ALL"]}}
          resources: {requests: {cpu: 500m, memory: 512Mi}, limits: {cpu: "2", memory: 2Gi}}
          startupProbe: {httpGet: {path: /ready, port: management}, periodSeconds: 2, timeoutSeconds: 2, failureThreshold: 30}
          readinessProbe: {httpGet: {path: /ready, port: management}, periodSeconds: 5, timeoutSeconds: 2, failureThreshold: 3}
          livenessProbe: {httpGet: {path: /health, port: management}, periodSeconds: 10, timeoutSeconds: 2, failureThreshold: 3}
          volumeMounts:
            - {name: runtime-config, mountPath: /etc/agenttrust/config/production-runtime.json, subPath: production-runtime.json, readOnly: true}
            - {name: secrets, mountPath: /etc/agenttrust/secrets/runtime, readOnly: true}
            - {name: evidence, mountPath: /var/lib/agenttrust/evidence, readOnly: true}
        - name: mtls-ingress
          image: "@@ENVOY_IMAGE@@"
          args: ["-c", "/etc/envoy/envoy.yaml", "--concurrency", "2"]
          ports: [{name: https, containerPort: 8443}]
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: ["ALL"]}}
          resources: {requests: {cpu: 100m, memory: 128Mi}, limits: {cpu: "1", memory: 512Mi}}
          readinessProbe: {tcpSocket: {port: https}, periodSeconds: 5, timeoutSeconds: 2, failureThreshold: 3}
          livenessProbe: {tcpSocket: {port: https}, periodSeconds: 10, timeoutSeconds: 2, failureThreshold: 3}
          volumeMounts:
            - {name: envoy-config, mountPath: /etc/envoy, readOnly: true}
            - {name: secrets, mountPath: /etc/agenttrust/secrets/runtime, readOnly: true}
            - {name: tmp, mountPath: /tmp}
      volumes:
        - {name: runtime-config, configMap: {name: agenttrust-production-runtime}}
        - {name: envoy-config, configMap: {name: agenttrust-envoy-runtime}}
        - name: secrets
          csi: {driver: secrets-store.csi.k8s.io, readOnly: true, volumeAttributes: {secretProviderClass: agenttrust-production-runtime}}
        - {name: evidence, persistentVolumeClaim: {claimName: agenttrust-release-evidence, readOnly: true}}
        - {name: tmp, emptyDir: {medium: Memory, sizeLimit: 64Mi}}
---
