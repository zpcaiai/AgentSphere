            - {name: AGENT_TRUST_SRE_DATABASE_MAX_CONNECTIONS, value: "20"}
            - {name: AGENT_TRUST_SRE_OUTBOUND_CA_FILE, value: /var/run/agenttrust/secrets/platform-sre/outbound-ca.pem}
            - {name: AGENT_TRUST_SRE_OUTBOUND_CERTIFICATE_FILE, value: /var/run/agenttrust/secrets/platform-sre/outbound-cert.pem}
