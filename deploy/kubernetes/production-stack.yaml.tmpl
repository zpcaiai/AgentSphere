---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: agenttrust-model-gateway
  labels: {app.kubernetes.io/part-of: agenttrust-control-plane, agenttrust.io/apply-phase: prerequisite}
automountServiceAccountToken: false
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: agenttrust-model-gateway
  labels: {app.kubernetes.io/name: agenttrust-model-gateway, app.kubernetes.io/component: model-gateway, app.kubernetes.io/part-of: agenttrust-control-plane, agenttrust.io/apply-phase: workload}
spec:
  replicas: 3
  revisionHistoryLimit: 10
  strategy: {type: RollingUpdate, rollingUpdate: {maxUnavailable: 0, maxSurge: 1}}
  selector: {matchLabels: {app.kubernetes.io/name: agenttrust-model-gateway}}
  template:
    metadata:
      labels: {app.kubernetes.io/name: agenttrust-model-gateway, app.kubernetes.io/component: model-gateway, app.kubernetes.io/part-of: agenttrust-control-plane}
      annotations:
        agenttrust.io/release-id: "@@RELEASE_ID@@"
        agenttrust.io/release-digest: "@@RELEASE_DIGEST@@"
        agenttrust.io/outbound-client-identity: "@@MODEL_GATEWAY_OUTBOUND_CLIENT_IDENTITY@@"
        agenttrust.io/readiness-schema: "@@MODEL_GATEWAY_READINESS_SCHEMA@@"
        agenttrust.io/service-subject: "@@MODEL_GATEWAY_SERVICE_SUBJECT@@"
        agenttrust.io/signing-key-id: "@@MODEL_GATEWAY_SIGNING_KEY_ID@@"
        agenttrust.io/organization-id: "@@MODEL_GATEWAY_ORGANIZATION_ID@@"
        agenttrust.io/agent-version: "@@MODEL_GATEWAY_AGENT_VERSION@@"
        agenttrust.io/region: "@@MODEL_GATEWAY_REGION@@"
        agenttrust.io/recovery-interval-seconds: "@@MODEL_GATEWAY_RECOVERY_INTERVAL_SECONDS@@"
        agenttrust.io/max-authentication-age-seconds: "@@MODEL_GATEWAY_MAX_AUTH_AGE_SECONDS@@"
    spec:
      serviceAccountName: agenttrust-model-gateway
      automountServiceAccountToken: false
      enableServiceLinks: false
      terminationGracePeriodSeconds: 60
      securityContext: {runAsNonRoot: true, runAsUser: 65532, runAsGroup: 65532, fsGroup: 65532, fsGroupChangePolicy: OnRootMismatch, seccompProfile: {type: RuntimeDefault}}
      topologySpreadConstraints:
        - {maxSkew: 1, minDomains: 3, topologyKey: topology.kubernetes.io/zone, whenUnsatisfiable: DoNotSchedule, labelSelector: {matchLabels: {app.kubernetes.io/name: agenttrust-model-gateway}}}
      containers:
        - name: authority
          image: "@@MODEL_GATEWAY_IMAGE@@"
          env:
            - {name: AGENT_TRUST_PROFILE, value: production}
            - {name: AGENT_TRUST_MODEL_DATABASE_URL_FILE, value: /var/run/agenttrust/secrets/model-gateway/database-url}
            - {name: AGENT_TRUST_MODEL_DATABASE_PASSWORD_FILE, value: /var/run/agenttrust/secrets/model-gateway/database-password}
            - {name: AGENT_TRUST_MODEL_DATABASE_CA_FILE, value: /var/run/agenttrust/secrets/model-gateway/database-ca.pem}
            - {name: AGENT_TRUST_MODEL_DATABASE_EXPECTED_ROLE, value: "@@MODEL_GATEWAY_APPLICATION_ROLE@@"}
            - {name: AGENT_TRUST_MODEL_DATABASE_MAX_CONNECTIONS, value: "20"}
            - {name: AGENT_TRUST_MODEL_OUTBOUND_CA_FILE, value: /var/run/agenttrust/secrets/model-gateway/outbound-ca.pem}
            - {name: AGENT_TRUST_MODEL_OUTBOUND_CERTIFICATE_FILE, value: /var/run/agenttrust/secrets/model-gateway/outbound-cert.pem}
            - {name: AGENT_TRUST_MODEL_OUTBOUND_PRIVATE_KEY_FILE, value: /var/run/agenttrust/secrets/model-gateway/outbound-key.pem}
            - {name: AGENT_TRUST_MODEL_TLS_CA_FILE, value: /var/run/agenttrust/secrets/model-gateway/caller-ca.pem}
            - {name: AGENT_TRUST_MODEL_TLS_CERTIFICATE_FILE, value: /var/run/agenttrust/secrets/model-gateway/server-cert.pem}
            - {name: AGENT_TRUST_MODEL_TLS_PRIVATE_KEY_FILE, value: /var/run/agenttrust/secrets/model-gateway/server-key.pem}
            - {name: AGENT_TRUST_MODEL_TOKEN_BINDINGS_FILE, value: /var/run/agenttrust/secrets/model-gateway/token-bindings.json}
            - {name: AGENT_TRUST_MODEL_PROVIDER_ENDPOINTS_FILE, value: /var/run/agenttrust/secrets/model-gateway/provider-endpoints.json}
            - {name: AGENT_TRUST_MODEL_PROVIDER_KEYRING_FILE, value: /var/run/agenttrust/secrets/model-gateway/provider-keyring.json}
            - {name: AGENT_TRUST_MODEL_EVIDENCE_KEYRING_FILE, value: /var/run/agenttrust/secrets/model-gateway/evidence-keyring.json}
            - {name: AGENT_TRUST_MODEL_CLIENT_IDENTITIES, value: "@@MODEL_GATEWAY_CLIENT_IDENTITIES@@"}
            - {name: AGENT_TRUST_MODEL_EVIDENCE_SOURCE_SERVICE, value: "@@MODEL_GATEWAY_EVIDENCE_CLIENT_IDENTITY@@"}
            - {name: AGENT_TRUST_MODEL_INSTANCE_ID, value: "@@MODEL_GATEWAY_INSTANCE_ID@@"}
            - {name: AGENT_TRUST_MODEL_EXECUTION_LEASE_SECONDS, value: "@@MODEL_GATEWAY_EXECUTION_LEASE_SECONDS@@"}
            - {name: AGENT_TRUST_MODEL_RECOVERY_INTERVAL_SECONDS, value: "@@MODEL_GATEWAY_RECOVERY_INTERVAL_SECONDS@@"}
            - {name: AGENT_TRUST_MODEL_LISTEN_ADDRESS, value: 0.0.0.0}
            - {name: AGENT_TRUST_MODEL_PORT, value: "@@MODEL_GATEWAY_DATA_PORT@@"}
            - {name: AGENT_TRUST_MODEL_MANAGEMENT_LISTEN_ADDRESS, value: 0.0.0.0}
            - {name: AGENT_TRUST_MODEL_MANAGEMENT_PORT, value: "@@MODEL_GATEWAY_MANAGEMENT_PORT@@"}
            - {name: AGENT_TRUST_MODEL_DATA_POLICY_ENDPOINT, value: "@@MODEL_GATEWAY_DATA_POLICY_ENDPOINT@@"}
            - {name: AGENT_TRUST_MODEL_DATA_POLICY_TOKEN_FILE, value: /var/run/agenttrust/secrets/model-gateway/data-policy.token}
            - {name: AGENT_TRUST_MODEL_DLP_ENDPOINT, value: "@@MODEL_GATEWAY_DLP_ENDPOINT@@"}
            - {name: AGENT_TRUST_MODEL_DLP_TOKEN_FILE, value: /var/run/agenttrust/secrets/model-gateway/dlp.token}
            - {name: AGENT_TRUST_MODEL_DATA_SANITIZER_ENDPOINT, value: "@@MODEL_GATEWAY_DATA_SANITIZER_ENDPOINT@@"}
            - {name: AGENT_TRUST_MODEL_DATA_SANITIZER_TOKEN_FILE, value: /var/run/agenttrust/secrets/model-gateway/data-sanitizer.token}
            - {name: AGENT_TRUST_MODEL_DATA_ARTIFACT_AUTHORIZER_ENDPOINT, value: "@@MODEL_GATEWAY_DATA_ARTIFACT_AUTHORIZER_ENDPOINT@@"}
            - {name: AGENT_TRUST_MODEL_DATA_ARTIFACT_AUTHORIZER_TOKEN_FILE, value: /var/run/agenttrust/secrets/model-gateway/data-artifact-authorizer.token}
            - {name: AGENT_TRUST_MODEL_DATA_MUTATION_ENDPOINT, value: "@@MODEL_GATEWAY_DATA_MUTATION_ENDPOINT@@"}
            - {name: AGENT_TRUST_MODEL_DATA_MUTATION_TOKEN_FILE, value: /var/run/agenttrust/secrets/model-gateway/data-mutation.token}
            - {name: AGENT_TRUST_MODEL_DATA_READ_ENDPOINT, value: "@@MODEL_GATEWAY_DATA_READ_ENDPOINT@@"}
            - {name: AGENT_TRUST_MODEL_DATA_READ_TOKEN_FILE, value: /var/run/agenttrust/secrets/model-gateway/data-read.token}
            - {name: AGENT_TRUST_MODEL_ARTIFACT_STORE_ENDPOINT, value: "@@MODEL_GATEWAY_ARTIFACT_STORE_ENDPOINT@@"}
            - {name: AGENT_TRUST_MODEL_ARTIFACT_STORE_TOKEN_FILE, value: /var/run/agenttrust/secrets/model-gateway/artifact-store.token}
            - {name: AGENT_TRUST_MODEL_ARTIFACT_STORE_JURISDICTION, value: production-region}
            - {name: AGENT_TRUST_MODEL_ARTIFACT_STORE_DESTINATION_KIND, value: retention-locked-object-store}
            - {name: AGENT_TRUST_MODEL_EVIDENCE_ENDPOINT, value: "@@MODEL_GATEWAY_EVIDENCE_ENDPOINT@@"}
            - {name: AGENT_TRUST_MODEL_EVIDENCE_TOKEN_FILE, value: /var/run/agenttrust/secrets/model-gateway/evidence.token}
          ports: [{name: data, containerPort: @@MODEL_GATEWAY_DATA_PORT@@}, {name: management, containerPort: @@MODEL_GATEWAY_MANAGEMENT_PORT@@}]
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: ["ALL"]}}
          resources: {requests: {cpu: 250m, memory: 256Mi}, limits: {cpu: "2", memory: 2Gi}}
          startupProbe: {httpGet: {path: /live, port: management}, periodSeconds: 2, timeoutSeconds: 2, failureThreshold: 60}
          readinessProbe: {httpGet: {path: /ready, port: management}, periodSeconds: 5, timeoutSeconds: 2, failureThreshold: 3}
          livenessProbe: {httpGet: {path: /live, port: management}, periodSeconds: 10, timeoutSeconds: 2, failureThreshold: 3}
          volumeMounts: [{name: secrets, mountPath: /var/run/agenttrust/secrets/model-gateway, readOnly: true}, {name: tmp, mountPath: /tmp}]
      volumes:
        - name: secrets
          csi: {driver: secrets-store.csi.k8s.io, readOnly: true, volumeAttributes: {secretProviderClass: agenttrust-model-gateway}}
        - {name: tmp, emptyDir: {medium: Memory, sizeLimit: 128Mi}}
---
apiVersion: v1
kind: Service
metadata:
  name: agenttrust-model-gateway
  labels: {app.kubernetes.io/part-of: agenttrust-control-plane, agenttrust.io/apply-phase: workload}
spec:
  selector: {app.kubernetes.io/name: agenttrust-model-gateway}
  ports: [{name: data, port: @@MODEL_GATEWAY_DATA_PORT@@, targetPort: data}, {name: management, port: @@MODEL_GATEWAY_MANAGEMENT_PORT@@, targetPort: management}]
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: agenttrust-model-gateway
  labels: {app.kubernetes.io/part-of: agenttrust-control-plane, agenttrust.io/apply-phase: workload}
spec: {minAvailable: 2, selector: {matchLabels: {app.kubernetes.io/name: agenttrust-model-gateway}}}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: agenttrust-model-gateway-network
  labels: {app.kubernetes.io/part-of: agenttrust-control-plane, agenttrust.io/apply-phase: prerequisite}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/component: model-gateway}}
  policyTypes: [Ingress, Egress]
  ingress:
    - from: [{podSelector: {matchLabels: {app.kubernetes.io/component: enterprise-api}}}, {podSelector: {matchLabels: {app.kubernetes.io/component: tool-proxy}}}]
      ports: [{protocol: TCP, port: @@MODEL_GATEWAY_DATA_PORT@@}]
    - from: [{ipBlock: {cidr: "@@NODE_CIDR@@"}}]
      ports: [{protocol: TCP, port: @@MODEL_GATEWAY_MANAGEMENT_PORT@@}]
  egress:
    - to: [{ipBlock: {cidr: "@@DATABASE_CIDR@@"}}]
      ports: [{protocol: TCP, port: 5432}]
    - to: [{ipBlock: {cidr: "@@VAULT_CIDR@@"}}, {ipBlock: {cidr: "@@EXTERNAL_SERVICE_EGRESS_CIDR@@"}}, {ipBlock: {cidr: "@@EVIDENCE_STORAGE_CIDR@@"}}]
      ports: [{protocol: TCP, port: 443}, {protocol: TCP, port: 8443}]
    - to: [{ipBlock: {cidr: "@@DNS_CIDR@@"}}]
      ports: [{protocol: UDP, port: 53}, {protocol: TCP, port: 53}]
