      - {objectName: "outbound-cert.pem", secretPath: "@@VAULT_MODEL_GATEWAY_PATH@@", secretKey: "outbound_certificate", filePermission: 0o440}
      - {objectName: "outbound-key.pem", secretPath: "@@VAULT_MODEL_GATEWAY_PATH@@", secretKey: "outbound_private_key", filePermission: 0o440}
