apiVersion: apps/v1
kind: Deployment
metadata:
  name: agenttrust-production-runtime
  labels:
    app.kubernetes.io/name: agenttrust-production-runtime
    app.kubernetes.io/component: runtime
    app.kubernetes.io/part-of: agenttrust-control-plane
    agenttrust.io/apply-phase: workload
  annotations: {agenttrust.io/release-id: "@@RELEASE_ID@@"}
spec:
  replicas: 3
  revisionHistoryLimit: 10
  strategy: {type: RollingUpdate, rollingUpdate: {maxUnavailable: 0, maxSurge: 1}}
  selector: {matchLabels: {app.kubernetes.io/name: agenttrust-production-runtime}}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: agenttrust-production-runtime
        app.kubernetes.io/component: runtime
        app.kubernetes.io/part-of: agenttrust-control-plane
      annotations:
        agenttrust.io/release-id: "@@RELEASE_ID@@"
        agenttrust.io/release-digest: "@@RELEASE_DIGEST@@"
    spec:
      serviceAccountName: agenttrust-production-runtime
      automountServiceAccountToken: false
      enableServiceLinks: false
      terminationGracePeriodSeconds: 60
      securityContext: {runAsNonRoot: true, runAsUser: 65532, runAsGroup: 65532, fsGroup: 65532, fsGroupChangePolicy: OnRootMismatch, seccompProfile: {type: RuntimeDefault}}
      topologySpreadConstraints:
        - maxSkew: 1
          minDomains: 3
          topologyKey: topology.kubernetes.io/zone
          whenUnsatisfiable: DoNotSchedule
          labelSelector: {matchLabels: {app.kubernetes.io/name: agenttrust-production-runtime}}
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - topologyKey: kubernetes.io/hostname
              labelSelector: {matchLabels: {app.kubernetes.io/name: agenttrust-production-runtime}}
      initContainers:
        - name: verify-release-evidence
          image: "@@UTILITY_IMAGE@@"
          command: ["/bin/sh", "-ec"]
          args:
            - |
              test "$(cat /evidence/release-id)" = "$RELEASE_ID"
              test -s /evidence/batch-statuses.json
              test -s /evidence/gate-evidence.json
              test -s /evidence/residual-risks.json
              test -s /evidence/exceptions.json
              test -s /evidence/SHA256SUMS
              test "$(sha256sum /evidence/SHA256SUMS | awk '{print $1}')" = "$BUNDLE_DIGEST"
              cd /evidence && sha256sum -c SHA256SUMS
          env:
            - {name: RELEASE_ID, value: "@@RELEASE_ID@@"}
            - {name: BUNDLE_DIGEST, value: "@@EVIDENCE_BUNDLE_DIGEST@@"}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: ["ALL"]}}
          resources: {requests: {cpu: 10m, memory: 16Mi}, limits: {cpu: 100m, memory: 64Mi}}
          volumeMounts: [{name: evidence, mountPath: /evidence, readOnly: true}]
      containers:
        - name: runtime
          image: "@@RUNTIME_IMAGE@@"
          imagePullPolicy: IfNotPresent
          args: ["/etc/agenttrust/config/production-runtime.json"]
          ports:
            - {name: data, containerPort: 8080}
            - {name: management, containerPort: 9090}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: ["ALL"]}}
          resources: {requests: {cpu: 500m, memory: 512Mi}, limits: {cpu: "2", memory: 2Gi}}
          startupProbe: {httpGet: {path: /ready, port: management}, periodSeconds: 2, timeoutSeconds: 2, failureThreshold: 30}
          readinessProbe: {httpGet: {path: /ready, port: management}, periodSeconds: 5, timeoutSeconds: 2, failureThreshold: 3}
          livenessProbe: {httpGet: {path: /health, port: management}, periodSeconds: 10, timeoutSeconds: 2, failureThreshold: 3}
          volumeMounts:
            - {name: runtime-config, mountPath: /etc/agenttrust/config/production-runtime.json, subPath: production-runtime.json, readOnly: true}
            - {name: secrets, mountPath: /etc/agenttrust/secrets/runtime, readOnly: true}
            - {name: evidence, mountPath: /var/lib/agenttrust/evidence, readOnly: true}
        - name: mtls-ingress
          image: "@@ENVOY_IMAGE@@"
          args: ["-c", "/etc/envoy/envoy.yaml", "--concurrency", "2"]
          ports: [{name: https, containerPort: 8443}]
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: ["ALL"]}}
          resources: {requests: {cpu: 100m, memory: 128Mi}, limits: {cpu: "1", memory: 512Mi}}
          readinessProbe: {tcpSocket: {port: https}, periodSeconds: 5, timeoutSeconds: 2, failureThreshold: 3}
          livenessProbe: {tcpSocket: {port: https}, periodSeconds: 10, timeoutSeconds: 2, failureThreshold: 3}
          volumeMounts:
            - {name: envoy-config, mountPath: /etc/envoy, readOnly: true}
            - {name: secrets, mountPath: /etc/agenttrust/secrets/runtime, readOnly: true}
            - {name: tmp, mountPath: /tmp}
      volumes:
        - {name: runtime-config, configMap: {name: agenttrust-production-runtime}}
        - {name: envoy-config, configMap: {name: agenttrust-envoy-runtime}}
        - name: secrets
          csi: {driver: secrets-store.csi.k8s.io, readOnly: true, volumeAttributes: {secretProviderClass: agenttrust-production-runtime}}
        - {name: evidence, persistentVolumeClaim: {claimName: agenttrust-release-evidence, readOnly: true}}
        - {name: tmp, emptyDir: {medium: Memory, sizeLimit: 64Mi}}
