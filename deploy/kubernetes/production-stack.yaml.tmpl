apiVersion: v1
kind: ConfigMap
metadata:
  name: agenttrust-envoy-runtime
  labels: {app.kubernetes.io/part-of: agenttrust-control-plane, agenttrust.io/apply-phase: prerequisite}
data:
  envoy.yaml: |
    static_resources:
      listeners:
        - name: ingress
          address: {socket_address: {address: 0.0.0.0, port_value: 8443}}
          filter_chains:
            - transport_socket:
                name: envoy.transport_sockets.tls
                typed_config:
                  "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
                  require_client_certificate: true
                  common_tls_context:
                    tls_certificates:
                      - certificate_chain: {filename: /etc/agenttrust/secrets/runtime/server-cert.pem}
                        private_key: {filename: /etc/agenttrust/secrets/runtime/server-key.pem}
                    validation_context: {trusted_ca: {filename: /etc/agenttrust/secrets/runtime/enterprise-ca.pem}}
              filters:
                - name: envoy.filters.network.http_connection_manager
                  typed_config:
                    "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                    stat_prefix: runtime_ingress
                    request_headers_to_remove: [x-agenttrust-peer-certificate-sha256]
                    request_headers_to_add:
                      - header: {key: x-agenttrust-peer-certificate-sha256, value: "%DOWNSTREAM_PEER_FINGERPRINT_256%"}
                        append_action: OVERWRITE_IF_EXISTS_OR_ADD
                    route_config:
                      name: runtime
                      virtual_hosts:
                        - name: runtime
                          domains: ["*"]
                          routes: [{match: {prefix: "/"}, route: {cluster: runtime, timeout: 30s}}]
                    http_filters:
                      - name: envoy.filters.http.router
                        typed_config: {"@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router}
      clusters:
        - name: runtime
          type: STATIC
          connect_timeout: 2s
          load_assignment:
            cluster_name: runtime
            endpoints: [{lb_endpoints: [{endpoint: {address: {socket_address: {address: 127.0.0.1, port_value: 8080}}}}]}]
---
