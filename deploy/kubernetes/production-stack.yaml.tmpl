apiVersion: secrets-store.csi.x-k8s.io/v1
kind: SecretProviderClass
metadata: {name: agenttrust-platform-sre, labels: {app.kubernetes.io/part-of: agenttrust-control-plane, agenttrust.io/apply-phase: prerequisite}}
spec:
  provider: vault
  parameters:
    vaultAddress: "@@VAULT_ADDRESS@@"
    vaultSkipTLSVerify: "false"
    roleName: "@@VAULT_PLATFORM_SRE_ROLE@@"
    objects: |
      - {objectName: "database-url", secretPath: "@@VAULT_PLATFORM_SRE_PATH@@", secretKey: "database_url", filePermission: 0o440}
      - {objectName: "database-password", secretPath: "@@VAULT_PLATFORM_SRE_PATH@@", secretKey: "database_password", filePermission: 0o440}
      - {objectName: "database-ca.pem", secretPath: "@@VAULT_PLATFORM_SRE_PATH@@", secretKey: "database_ca", filePermission: 0o440}
      - {objectName: "caller-ca.pem", secretPath: "@@VAULT_PLATFORM_SRE_PATH@@", secretKey: "caller_ca", filePermission: 0o440}
      - {objectName: "server-cert.pem", secretPath: "@@VAULT_PLATFORM_SRE_PATH@@", secretKey: "server_certificate", filePermission: 0o440}
      - {objectName: "server-key.pem", secretPath: "@@VAULT_PLATFORM_SRE_PATH@@", secretKey: "server_private_key", filePermission: 0o440}
      - {objectName: "outbound-ca.pem", secretPath: "@@VAULT_PLATFORM_SRE_PATH@@", secretKey: "outbound_ca", filePermission: 0o440}
      - {objectName: "outbound-cert.pem", secretPath: "@@VAULT_PLATFORM_SRE_PATH@@", secretKey: "outbound_certificate", filePermission: 0o440}
      - {objectName: "outbound-key.pem", secretPath: "@@VAULT_PLATFORM_SRE_PATH@@", secretKey: "outbound_private_key", filePermission: 0o440}
      - {objectName: "token-bindings.json", secretPath: "@@VAULT_PLATFORM_SRE_PATH@@", secretKey: "token_bindings", filePermission: 0o440}
      - {objectName: "evidence-keyring.json", secretPath: "@@VAULT_PLATFORM_SRE_PATH@@", secretKey: "evidence_keyring", filePermission: 0o440}
      - {objectName: "human-principal-keyring.json", secretPath: "@@VAULT_PLATFORM_SRE_PATH@@", secretKey: "human_principal_keyring", filePermission: 0o440}
      - {objectName: "report-signing.key", secretPath: "@@VAULT_PLATFORM_SRE_PATH@@", secretKey: "report_signing_key", filePermission: 0o440}
      - {objectName: "orchestrator.token", secretPath: "@@VAULT_PLATFORM_SRE_PATH@@", secretKey: "orchestrator_token", filePermission: 0o440}
      - {objectName: "backup.token", secretPath: "@@VAULT_PLATFORM_SRE_PATH@@", secretKey: "backup_token", filePermission: 0o440}
      - {objectName: "recovery.token", secretPath: "@@VAULT_PLATFORM_SRE_PATH@@", secretKey: "recovery_token", filePermission: 0o440}
      - {objectName: "dr.token", secretPath: "@@VAULT_PLATFORM_SRE_PATH@@", secretKey: "dr_token", filePermission: 0o440}
      - {objectName: "chaos.token", secretPath: "@@VAULT_PLATFORM_SRE_PATH@@", secretKey: "chaos_token", filePermission: 0o440}
      - {objectName: "load.token", secretPath: "@@VAULT_PLATFORM_SRE_PATH@@", secretKey: "load_token", filePermission: 0o440}
      - {objectName: "upgrade.token", secretPath: "@@VAULT_PLATFORM_SRE_PATH@@", secretKey: "upgrade_token", filePermission: 0o440}
      - {objectName: "evidence.token", secretPath: "@@VAULT_PLATFORM_SRE_PATH@@", secretKey: "evidence_token", filePermission: 0o440}
