            - {name: AGENT_TRUST_SRE_TLS_PRIVATE_KEY_FILE, value: /var/run/agenttrust/secrets/platform-sre/server-key.pem}
            - {name: AGENT_TRUST_SRE_TOKEN_BINDINGS_FILE, value: /var/run/agenttrust/secrets/platform-sre/token-bindings.json}
            - {name: AGENT_TRUST_SRE_EVIDENCE_KEYRING_FILE, value: /var/run/agenttrust/secrets/platform-sre/evidence-keyring.json}
            - {name: AGENT_TRUST_SRE_HUMAN_PRINCIPAL_KEYRING_FILE, value: /var/run/agenttrust/secrets/platform-sre/human-principal-keyring.json}
            - {name: AGENT_TRUST_SRE_REPORT_SIGNING_KEY_FILE, value: /var/run/agenttrust/secrets/platform-sre/report-signing.key}
            - {name: AGENT_TRUST_SRE_CLIENT_IDENTITIES, value: "@@PLATFORM_SRE_CLIENT_IDENTITIES@@"}
            - {name: AGENT_TRUST_SRE_EVIDENCE_CLIENT_IDENTITY, value: "@@PLATFORM_SRE_EVIDENCE_CLIENT_IDENTITY@@"}
            - {name: AGENT_TRUST_SRE_AGENT_INSTANCE_ID, value: "@@PLATFORM_SRE_INSTANCE_ID@@"}
            - {name: AGENT_TRUST_SRE_ORGANIZATION_ID, value: "@@PLATFORM_SRE_ORGANIZATION_ID@@"}
            - {name: AGENT_TRUST_SRE_AGENT_VERSION, value: "@@PLATFORM_SRE_AGENT_VERSION@@"}
            - {name: AGENT_TRUST_SRE_REGION, value: "@@PLATFORM_SRE_REGION@@"}
            - {name: AGENT_TRUST_SRE_TOOL_ID, value: platform-sre-executor}
