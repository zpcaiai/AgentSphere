  template:
    metadata:
      labels: {app.kubernetes.io/name: agenttrust-platform-sre, app.kubernetes.io/component: platform-sre, app.kubernetes.io/part-of: agenttrust-control-plane}
      annotations: {agenttrust.io/release-id: "@@RELEASE_ID@@", agenttrust.io/release-digest: "@@RELEASE_DIGEST@@", agenttrust.io/outbound-client-identity: "@@PLATFORM_SRE_OUTBOUND_CLIENT_IDENTITY@@", agenttrust.io/readiness-schema: "@@PLATFORM_SRE_READINESS_SCHEMA@@", agenttrust.io/recovery-interval-seconds: "@@PLATFORM_SRE_RECOVERY_INTERVAL_SECONDS@@"}
    spec:
      serviceAccountName: agenttrust-platform-sre
      automountServiceAccountToken: false
      enableServiceLinks: false
      securityContext: {runAsNonRoot: true, runAsUser: 65532, runAsGroup: 65532, fsGroup: 65532, seccompProfile: {type: RuntimeDefault}}
      topologySpreadConstraints: [{maxSkew: 1, minDomains: 3, topologyKey: topology.kubernetes.io/zone, whenUnsatisfiable: DoNotSchedule, labelSelector: {matchLabels: {app.kubernetes.io/name: agenttrust-platform-sre}}}]
