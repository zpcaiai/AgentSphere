apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: agenttrust-dns-egress
  labels: {app.kubernetes.io/part-of: agenttrust-control-plane, agenttrust.io/apply-phase: prerequisite}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/part-of: agenttrust-control-plane}}
  policyTypes: [Egress]
  egress:
    - to:
        - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: kube-system}}
          podSelector: {matchLabels: {k8s-app: kube-dns}}
      ports: [{protocol: UDP, port: 53}, {protocol: TCP, port: 53}]
    # Explicit resolver address covers NodeLocal DNSCache and CNI implementations that
    # enforce policy before/after Service DNAT differently. The renderer requires /32 or /128.
    - to: [{ipBlock: {cidr: "@@DNS_CIDR@@"}}]
      ports: [{protocol: UDP, port: 53}, {protocol: TCP, port: 53}]
