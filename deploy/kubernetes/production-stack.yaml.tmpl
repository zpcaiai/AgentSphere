apiVersion: apps/v1
kind: Deployment
metadata:
  name: agenttrust-enterprise-control
  labels: {app.kubernetes.io/name: agenttrust-enterprise-control, app.kubernetes.io/component: enterprise-api, app.kubernetes.io/part-of: agenttrust-control-plane, agenttrust.io/apply-phase: workload}
  annotations: {agenttrust.io/release-id: "@@RELEASE_ID@@"}
spec:
  replicas: 3
  revisionHistoryLimit: 10
  strategy: {type: RollingUpdate, rollingUpdate: {maxUnavailable: 0, maxSurge: 1}}
  selector: {matchLabels: {app.kubernetes.io/name: agenttrust-enterprise-control}}
  template:
    metadata:
      labels: {app.kubernetes.io/name: agenttrust-enterprise-control, app.kubernetes.io/component: enterprise-api, app.kubernetes.io/part-of: agenttrust-control-plane}
      annotations: {agenttrust.io/release-id: "@@RELEASE_ID@@", agenttrust.io/release-digest: "@@RELEASE_DIGEST@@"}
    spec:
      serviceAccountName: agenttrust-enterprise-control
      automountServiceAccountToken: false
      enableServiceLinks: false
      terminationGracePeriodSeconds: 60
      securityContext: {runAsNonRoot: true, runAsUser: 65532, runAsGroup: 65532, fsGroup: 65532, fsGroupChangePolicy: OnRootMismatch, seccompProfile: {type: RuntimeDefault}}
      topologySpreadConstraints:
        - {maxSkew: 1, minDomains: 3, topologyKey: topology.kubernetes.io/zone, whenUnsatisfiable: DoNotSchedule, labelSelector: {matchLabels: {app.kubernetes.io/name: agenttrust-enterprise-control}}}
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - {topologyKey: kubernetes.io/hostname, labelSelector: {matchLabels: {app.kubernetes.io/name: agenttrust-enterprise-control}}}
      containers:
        - name: api
          image: "@@ENTERPRISE_IMAGE@@"
          env:
            - {name: SPRING_PROFILES_ACTIVE, value: production}
            - {name: AGENT_TRUST_DATABASE_EXPECTED_ROLE, value: "@@ENTERPRISE_APPLICATION_ROLE@@"}
            - {name: SPRING_CONFIG_IMPORT, value: "optional:configtree:/var/run/agenttrust/secrets/enterprise/"}
            - {name: AGENT_TRUST_IAM_ISSUER, valueFrom: {configMapKeyRef: {name: agenttrust-enterprise-control, key: iam-issuer}}}
            - {name: AGENT_TRUST_IAM_JWKS_ENDPOINT, valueFrom: {configMapKeyRef: {name: agenttrust-enterprise-control, key: iam-jwks-endpoint}}}
            - {name: AGENT_TRUST_IAM_AUDIENCE, valueFrom: {configMapKeyRef: {name: agenttrust-enterprise-control, key: iam-audience}}}
            - {name: AGENT_TRUST_IAM_AUTHORIZATION_ENDPOINT, valueFrom: {configMapKeyRef: {name: agenttrust-enterprise-control, key: iam-authorization-endpoint}}}
            - {name: AGENT_TRUST_IAM_TOKEN_ENDPOINT, valueFrom: {configMapKeyRef: {name: agenttrust-enterprise-control, key: iam-token-endpoint}}}
            - {name: AGENT_TRUST_IAM_USERINFO_ENDPOINT, valueFrom: {configMapKeyRef: {name: agenttrust-enterprise-control, key: iam-userinfo-endpoint}}}
            - {name: AGENT_TRUST_CONSOLE_ORIGINS, valueFrom: {configMapKeyRef: {name: agenttrust-enterprise-control, key: console-origins}}}
            - {name: AGENT_TRUST_PEP_ENDPOINT, valueFrom: {configMapKeyRef: {name: agenttrust-enterprise-control, key: pep-endpoint}}}
