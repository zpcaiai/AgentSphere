        "tool_version": {"$ref": "#/$defs/identifier"},
        "executor_credential_profile": {"const": "pack-marketplace-executor"},
        "ingress_subject": {"$ref": "#/$defs/identifier"},
        "executor_subject": {"$ref": "#/$defs/identifier"},
        "query_subject": {"$ref": "#/$defs/identifier"},
        "release_gate_id": {"$ref": "#/$defs/shortIdentifier"},
        "maximum_authentication_age_seconds": {"type": "integer", "minimum": 60, "maximum": 86400}
      }
    },
    "enterpriseAuthority": {
      "type": "object", "additionalProperties": false,
      "required": [
        "client_identities", "outbound_client_identity", "agent_instance_id",
        "organization_id", "agent_version", "region", "tool_id", "tool_version",
        "executor_credential_profile", "service_subject",
        "maximum_authentication_age_seconds", "vault_kv_mount", "vault_kv_prefix"
      ],
      "properties": {
        "client_identities": {"$ref": "#/$defs/clientIdentities"},
        "outbound_client_identity": {"$ref": "#/$defs/clientIdentity"},
        "agent_instance_id": {"type": "string", "format": "uuid"},
        "organization_id": {"$ref": "#/$defs/identifier"},
        "agent_version": {"$ref": "#/$defs/identifier"},
        "region": {"$ref": "#/$defs/identifier"},
        "tool_id": {"$ref": "#/$defs/identifier"},
        "tool_version": {"$ref": "#/$defs/identifier"},
        "executor_credential_profile": {"$ref": "#/$defs/identifier"},
        "service_subject": {"$ref": "#/$defs/identifier"},
        "maximum_authentication_age_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
        "vault_kv_mount": {"$ref": "#/$defs/shortIdentifier"},
        "vault_kv_prefix": {"type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$", "maxLength": 128}
      }
    },
    "productionAuthority": {
      "type": "object", "additionalProperties": false,
      "required": [
        "client_identities", "outbound_client_identity", "evidence_client_identity",
        "instance_id", "organization_id", "agent_version", "region", "service_subject",
        "data_port", "management_port", "readiness_schema", "execution_lease_seconds",
        "recovery_interval_seconds", "signing_key_id",
        "maximum_authentication_age_seconds", "dependencies"
      ],
      "properties": {
        "client_identities": {"$ref": "#/$defs/clientIdentities"},
        "outbound_client_identity": {"$ref": "#/$defs/clientIdentity"},
        "evidence_client_identity": {"$ref": "#/$defs/clientIdentity"},
        "instance_id": {"type": "string", "format": "uuid"},
        "organization_id": {"$ref": "#/$defs/identifier"},
        "agent_version": {"$ref": "#/$defs/identifier"},
        "region": {"$ref": "#/$defs/identifier"},
        "service_subject": {"$ref": "#/$defs/identifier"},
        "data_port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "management_port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "readiness_schema": {"$ref": "#/$defs/shortIdentifier"},
        "execution_lease_seconds": {"type": "integer", "minimum": 15, "maximum": 300},
        "recovery_interval_seconds": {"type": "integer", "minimum": 5, "maximum": 300},
        "signing_key_id": {"$ref": "#/$defs/shortIdentifier"},
        "maximum_authentication_age_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
        "dependencies": {
          "type": "object", "minProperties": 1, "maxProperties": 32,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "additionalProperties": {"$ref": "#/$defs/https"}
        }
      }
    },
    "productionAuthorities": {
      "type": "object", "additionalProperties": false,
      "required": ["model_gateway", "data_governance", "context_governance", "runtime_anomaly", "security_evaluation", "pack_supply_chain", "domain_runtime", "platform_sre"],
      "properties": {
        "model_gateway": {"$ref": "#/$defs/productionAuthority"},
        "data_governance": {"$ref": "#/$defs/productionAuthority"},
        "context_governance": {"$ref": "#/$defs/productionAuthority"},
