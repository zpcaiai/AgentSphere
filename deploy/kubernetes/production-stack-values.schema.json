{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttrust.example/schemas/deployment/production-stack-values.v2.json",
  "title": "AgentTrust production stack non-secret values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "release_id", "release_digest", "images", "database",
    "temporal", "execution", "registry", "agent_registry", "policy_admin", "incident_release", "pack_marketplace", "transition", "authorities",
    "enterprise_authority", "production_authorities", "vault", "network", "evidence", "ingress",
    "transition_facts", "enterprise"
  ],
  "properties": {
    "schema_version": {"const": "agenttrust.production-stack-values.v2"},
    "release_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "not": {"const": "WORKTREE-NO-GIT"}},
    "release_digest": {"$ref": "#/$defs/digest"},
    "images": {"$ref": "#/$defs/images"},
    "database": {"$ref": "#/$defs/database"},
    "temporal": {"$ref": "#/$defs/temporal"},
    "execution": {"$ref": "#/$defs/execution"},
    "registry": {"$ref": "#/$defs/registry"},
    "agent_registry": {"$ref": "#/$defs/agentRegistry"},
    "policy_admin": {"$ref": "#/$defs/policyAdmin"},
    "incident_release": {"$ref": "#/$defs/incidentRelease"},
    "pack_marketplace": {"$ref": "#/$defs/packMarketplace"},
    "transition": {"$ref": "#/$defs/clientAuthority"},
    "authorities": {"$ref": "#/$defs/authorities"},
    "enterprise_authority": {"$ref": "#/$defs/enterpriseAuthority"},
    "production_authorities": {"$ref": "#/$defs/productionAuthorities"},
    "vault": {"$ref": "#/$defs/vault"},
    "network": {"$ref": "#/$defs/network"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "ingress": {"$ref": "#/$defs/ingress"},
    "transition_facts": {"$ref": "#/$defs/factEndpoints"},
    "enterprise": {"$ref": "#/$defs/enterprise"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "shortIdentifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "databaseRole": {"type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "image": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]*@sha256:[0-9a-f]{64}$"},
    "https": {"type": "string", "pattern": "^https://[^@/?#]+(?:/[^?#]*)?$"},
    "images": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime", "orchestrator", "transition", "execution", "registry", "agent_registry", "policy_admin", "incident_release", "pack_marketplace", "approval", "pep", "identity", "tool_proxy", "evidence", "audit", "enterprise", "enterprise_authority", "model_gateway", "data_governance", "context_governance", "runtime_anomaly", "security_evaluation", "pack_supply_chain", "domain_runtime", "platform_sre", "console", "migration", "envoy", "utility"],
      "properties": {
        "runtime": {"$ref": "#/$defs/image"}, "orchestrator": {"$ref": "#/$defs/image"},
        "transition": {"$ref": "#/$defs/image"}, "execution": {"$ref": "#/$defs/image"},
        "registry": {"$ref": "#/$defs/image"}, "agent_registry": {"$ref": "#/$defs/image"},
        "policy_admin": {"$ref": "#/$defs/image"},
        "incident_release": {"$ref": "#/$defs/image"},
        "pack_marketplace": {"$ref": "#/$defs/image"},
        "approval": {"$ref": "#/$defs/image"},
        "pep": {"$ref": "#/$defs/image"}, "identity": {"$ref": "#/$defs/image"},
        "tool_proxy": {"$ref": "#/$defs/image"}, "evidence": {"$ref": "#/$defs/image"}, "audit": {"$ref": "#/$defs/image"},
        "enterprise": {"$ref": "#/$defs/image"}, "enterprise_authority": {"$ref": "#/$defs/image"},
        "model_gateway": {"$ref": "#/$defs/image"},
        "data_governance": {"$ref": "#/$defs/image"},
        "context_governance": {"$ref": "#/$defs/image"},
        "runtime_anomaly": {"$ref": "#/$defs/image"},
        "security_evaluation": {"$ref": "#/$defs/image"},
        "pack_supply_chain": {"$ref": "#/$defs/image"},
        "domain_runtime": {"$ref": "#/$defs/image"},
        "platform_sre": {"$ref": "#/$defs/image"},
        "console": {"$ref": "#/$defs/image"},
        "migration": {"$ref": "#/$defs/image"}, "envoy": {"$ref": "#/$defs/image"},
        "utility": {"$ref": "#/$defs/image"}
      }
    },
    "database": {
      "type": "object", "additionalProperties": false,
      "required": ["enterprise_application_role", "enterprise_authority_application_role", "orchestrator_application_role", "execution_application_role", "registry_application_role", "agent_registry_application_role", "policy_admin_application_role", "incident_release_application_role", "pack_marketplace_application_role", "approval_application_role", "pep_application_role", "identity_application_role", "tool_proxy_application_role", "evidence_application_role", "audit_application_role", "model_gateway_application_role", "data_governance_application_role", "context_governance_application_role", "runtime_anomaly_application_role", "security_evaluation_application_role", "pack_supply_chain_application_role", "domain_runtime_application_role", "platform_sre_application_role"],
      "properties": {
        "enterprise_application_role": {"$ref": "#/$defs/databaseRole"},
        "enterprise_authority_application_role": {"$ref": "#/$defs/databaseRole"},
        "orchestrator_application_role": {"$ref": "#/$defs/databaseRole"},
        "execution_application_role": {"$ref": "#/$defs/databaseRole"},
        "registry_application_role": {"$ref": "#/$defs/databaseRole"},
        "agent_registry_application_role": {"$ref": "#/$defs/databaseRole"},
        "policy_admin_application_role": {"$ref": "#/$defs/databaseRole"},
        "incident_release_application_role": {"$ref": "#/$defs/databaseRole"},
        "pack_marketplace_application_role": {"$ref": "#/$defs/databaseRole"},
        "approval_application_role": {"$ref": "#/$defs/databaseRole"},
        "pep_application_role": {"$ref": "#/$defs/databaseRole"},
        "identity_application_role": {"$ref": "#/$defs/databaseRole"},
        "tool_proxy_application_role": {"$ref": "#/$defs/databaseRole"},
        "evidence_application_role": {"$ref": "#/$defs/databaseRole"},
        "audit_application_role": {"$ref": "#/$defs/databaseRole"},
        "model_gateway_application_role": {"$ref": "#/$defs/databaseRole"},
        "data_governance_application_role": {"$ref": "#/$defs/databaseRole"},
        "context_governance_application_role": {"$ref": "#/$defs/databaseRole"},
        "runtime_anomaly_application_role": {"$ref": "#/$defs/databaseRole"},
        "security_evaluation_application_role": {"$ref": "#/$defs/databaseRole"},
        "pack_supply_chain_application_role": {"$ref": "#/$defs/databaseRole"},
        "domain_runtime_application_role": {"$ref": "#/$defs/databaseRole"},
        "platform_sre_application_role": {"$ref": "#/$defs/databaseRole"}
      }
    },
    "temporal": {
      "type": "object", "additionalProperties": false,
      "required": ["address", "namespace", "task_queue", "server_name"],
      "properties": {"address": {"type": "string"}, "namespace": {"$ref": "#/$defs/shortIdentifier"}, "task_queue": {"$ref": "#/$defs/shortIdentifier"}, "server_name": {"type": "string"}}
