      "properties": {
        "client_identities": {"$ref": "#/$defs/clientIdentities"},
        "outbound_client_identity": {"$ref": "#/$defs/clientIdentity"},
        "detection_client_identity": {"$ref": "#/$defs/clientIdentity"},
        "agent_instance_id": {"type": "string", "format": "uuid"},
        "organization_id": {"$ref": "#/$defs/identifier"},
        "agent_version": {"$ref": "#/$defs/identifier"},
        "region": {"$ref": "#/$defs/identifier"},
        "tool_id": {"$ref": "#/$defs/identifier"},
        "tool_version": {"$ref": "#/$defs/identifier"},
        "executor_credential_profile": {"const": "incident-release-executor"},
        "service_subject": {"$ref": "#/$defs/identifier"},
        "release_signing_key_id": {"$ref": "#/$defs/shortIdentifier"},
        "maximum_authentication_age_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
        "execution_lease_seconds": {"type": "integer", "minimum": 15, "maximum": 300},
        "containment_endpoint": {"$ref": "#/$defs/https"},
        "replay_endpoint": {"$ref": "#/$defs/https"}
      }
