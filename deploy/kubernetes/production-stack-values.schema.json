{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttrust.example/schemas/deployment/production-stack-values.v1.json",
  "title": "AgentTrust production stack non-secret values",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "release_digest", "images", "database", "temporal", "execution", "transition", "vault", "network", "evidence", "ingress", "transition_facts", "enterprise"],
  "properties": {
    "schema_version": {"const": "agenttrust.production-stack-values.v1"},
    "release_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "not": {"const": "WORKTREE-NO-GIT"}},
    "release_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "images": {"$ref": "#/$defs/images"},
    "database": {"$ref": "#/$defs/database"},
    "temporal": {"$ref": "#/$defs/temporal"},
    "execution": {"$ref": "#/$defs/execution"},
    "transition": {"$ref": "#/$defs/transition"},
    "vault": {"$ref": "#/$defs/vault"},
    "network": {"$ref": "#/$defs/network"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "ingress": {"$ref": "#/$defs/ingress"},
    "transition_facts": {"$ref": "#/$defs/factEndpoints"},
    "enterprise": {"$ref": "#/$defs/enterprise"}
  },
  "$defs": {
    "image": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]*@sha256:[0-9a-f]{64}$"},
    "https": {"type": "string", "pattern": "^https://[^@/?#]+(?:/[^?#]*)?$"},
    "images": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime", "orchestrator", "transition", "execution", "enterprise", "console", "migration", "envoy", "utility"],
      "properties": {"runtime": {"$ref": "#/$defs/image"}, "orchestrator": {"$ref": "#/$defs/image"}, "transition": {"$ref": "#/$defs/image"}, "execution": {"$ref": "#/$defs/image"}, "enterprise": {"$ref": "#/$defs/image"}, "console": {"$ref": "#/$defs/image"}, "migration": {"$ref": "#/$defs/image"}, "envoy": {"$ref": "#/$defs/image"}, "utility": {"$ref": "#/$defs/image"}}
    },
    "database": {"type": "object", "additionalProperties": false, "required": ["enterprise_application_role", "orchestrator_application_role", "execution_application_role"], "properties": {"enterprise_application_role": {"type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$"}, "orchestrator_application_role": {"type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$"}, "execution_application_role": {"type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$"}}},
    "temporal": {"type": "object", "additionalProperties": false, "required": ["address", "namespace", "task_queue", "server_name"], "properties": {"address": {"type": "string"}, "namespace": {"type": "string"}, "task_queue": {"type": "string"}, "server_name": {"type": "string"}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["client_identities", "approval_endpoint", "approval_readiness_schema", "pep_endpoint", "pep_readiness_schema", "tool_endpoint", "tool_readiness_schema", "evidence_endpoint", "evidence_readiness_schema"], "properties": {"client_identities": {"$ref": "#/$defs/clientIdentities"}, "approval_endpoint": {"$ref": "#/$defs/https"}, "approval_readiness_schema": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "pep_endpoint": {"$ref": "#/$defs/https"}, "pep_readiness_schema": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "tool_endpoint": {"$ref": "#/$defs/https"}, "tool_readiness_schema": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "evidence_endpoint": {"$ref": "#/$defs/https"}, "evidence_readiness_schema": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}}},
    "transition": {"type": "object", "additionalProperties": false, "required": ["client_identities"], "properties": {"client_identities": {"$ref": "#/$defs/clientIdentities"}}},
    "vault": {"type": "object", "additionalProperties": false, "required": ["address", "runtime_role", "runtime_path", "orchestrator_role", "orchestrator_path", "transition_role", "transition_path", "execution_role", "execution_path", "enterprise_role", "enterprise_path", "migration_role", "migration_path"], "properties": {"address": {"$ref": "#/$defs/https"}, "runtime_role": {"type": "string"}, "runtime_path": {"type": "string"}, "orchestrator_role": {"type": "string"}, "orchestrator_path": {"type": "string"}, "transition_role": {"type": "string"}, "transition_path": {"type": "string"}, "execution_role": {"type": "string"}, "execution_path": {"type": "string"}, "enterprise_role": {"type": "string"}, "enterprise_path": {"type": "string"}, "migration_role": {"type": "string"}, "migration_path": {"type": "string"}}},
    "network": {"type": "object", "additionalProperties": false, "required": ["node_cidr", "database_cidr", "temporal_cidr", "trusted_service_cidr", "execution_approval_cidr", "execution_pep_cidr", "execution_tool_cidr", "execution_evidence_cidr", "dns_cidr"], "properties": {"node_cidr": {"type": "string"}, "database_cidr": {"type": "string"}, "temporal_cidr": {"type": "string"}, "trusted_service_cidr": {"type": "string"}, "execution_approval_cidr": {"type": "string"}, "execution_pep_cidr": {"type": "string"}, "execution_tool_cidr": {"type": "string"}, "execution_evidence_cidr": {"type": "string"}, "dns_cidr": {"type": "string", "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/32$|^[0-9A-Fa-f:]+/128$"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["persistent_volume_name", "bundle_digest", "storage_size"], "properties": {"persistent_volume_name": {"type": "string"}, "bundle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "storage_size": {"type": "string"}}},
    "ingress": {"type": "object", "additionalProperties": false, "required": ["class", "console_host", "control_api_host", "console_tls_secret", "control_api_tls_secret"], "properties": {"class": {"type": "string"}, "console_host": {"type": "string"}, "control_api_host": {"type": "string"}, "console_tls_secret": {"type": "string"}, "control_api_tls_secret": {"type": "string"}}},
    "factEndpoints": {"type": "object", "additionalProperties": false, "required": ["policy", "approval", "credential", "ledger", "evaluator", "evidence", "supervisor"], "properties": {"policy": {"$ref": "#/$defs/https"}, "approval": {"$ref": "#/$defs/https"}, "credential": {"$ref": "#/$defs/https"}, "ledger": {"$ref": "#/$defs/https"}, "evaluator": {"$ref": "#/$defs/https"}, "evidence": {"$ref": "#/$defs/https"}, "supervisor": {"$ref": "#/$defs/https"}}},
    "authorityEndpoints": {"type": "object", "additionalProperties": false, "required": ["agents", "approvals", "evidence", "incidents", "policies", "tools", "credentials", "packs", "trace", "compliance", "audit", "sre", "deployments"], "properties": {"agents": {"$ref": "#/$defs/https"}, "approvals": {"$ref": "#/$defs/https"}, "evidence": {"$ref": "#/$defs/https"}, "incidents": {"$ref": "#/$defs/https"}, "policies": {"$ref": "#/$defs/https"}, "tools": {"$ref": "#/$defs/https"}, "credentials": {"$ref": "#/$defs/https"}, "packs": {"$ref": "#/$defs/https"}, "trace": {"$ref": "#/$defs/https"}, "compliance": {"$ref": "#/$defs/https"}, "audit": {"$ref": "#/$defs/https"}, "sre": {"$ref": "#/$defs/https"}, "deployments": {"$ref": "#/$defs/https"}}},
    "clientIdentities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:DNS:[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?|URI:spiffe://[A-Za-z0-9.-]+(?:/[A-Za-z0-9._~!$&()*+;=:@%-]+)*)$"}},
    "enterprise": {"type": "object", "additionalProperties": false, "required": ["iam_issuer", "iam_jwks_endpoint", "iam_audience", "iam_authorization_endpoint", "iam_token_endpoint", "iam_userinfo_endpoint", "pep_endpoint", "orchestrator_runtime_client_identities", "orchestrator_bff_client_identities", "authority_endpoints"], "properties": {"iam_issuer": {"$ref": "#/$defs/https"}, "iam_jwks_endpoint": {"$ref": "#/$defs/https"}, "iam_audience": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "iam_authorization_endpoint": {"$ref": "#/$defs/https"}, "iam_token_endpoint": {"$ref": "#/$defs/https"}, "iam_userinfo_endpoint": {"$ref": "#/$defs/https"}, "pep_endpoint": {"$ref": "#/$defs/https"}, "orchestrator_runtime_client_identities": {"$ref": "#/$defs/clientIdentities"}, "orchestrator_bff_client_identities": {"$ref": "#/$defs/clientIdentities"}, "authority_endpoints": {"$ref": "#/$defs/authorityEndpoints"}}}
  }
}
