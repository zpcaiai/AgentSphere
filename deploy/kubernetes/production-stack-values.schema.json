    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["client_identities", "outbound_client_identity", "approval_readiness_schema", "pep_readiness_schema", "tool_readiness_schema", "evidence_readiness_schema"],
      "properties": {
        "client_identities": {"$ref": "#/$defs/clientIdentities"},
        "outbound_client_identity": {"allOf": [{"$ref": "#/$defs/clientIdentity"}, {"maxLength": 256}]},
        "approval_readiness_schema": {"$ref": "#/$defs/shortIdentifier"},
        "pep_readiness_schema": {"$ref": "#/$defs/shortIdentifier"},
        "tool_readiness_schema": {"$ref": "#/$defs/shortIdentifier"},
        "evidence_readiness_schema": {"$ref": "#/$defs/shortIdentifier"}
      }
    },
    "registry": {
      "type": "object", "additionalProperties": false,
      "required": ["client_identities", "publisher_id", "publisher_key_id"],
      "properties": {"client_identities": {"$ref": "#/$defs/clientIdentities"}, "publisher_id": {"$ref": "#/$defs/shortIdentifier"}, "publisher_key_id": {"$ref": "#/$defs/shortIdentifier"}}
