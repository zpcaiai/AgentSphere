    },
    "auditAuthority": {
      "type": "object", "additionalProperties": false,
      "required": ["client_identities", "issuer", "key_id", "worm_endpoint", "deletion_endpoint", "max_export_bytes", "max_request_bytes"],
      "properties": {
        "client_identities": {"$ref": "#/$defs/clientIdentities"}, "issuer": {"$ref": "#/$defs/identifier"},
        "key_id": {"$ref": "#/$defs/shortIdentifier"}, "worm_endpoint": {"$ref": "#/$defs/https"},
        "deletion_endpoint": {"$ref": "#/$defs/https"},
        "max_export_bytes": {"type": "integer", "minimum": 1048576, "maximum": 67108864},
        "max_request_bytes": {"type": "integer", "minimum": 65536, "maximum": 16777216}
