      "properties": {
        "client_identities": {"$ref": "#/$defs/clientIdentities"}, "issuer": {"$ref": "#/$defs/identifier"}, "key_id": {"$ref": "#/$defs/shortIdentifier"},
        "principal_audience": {"$ref": "#/$defs/identifier"}, "principal_issuer": {"$ref": "#/$defs/identifier"}, "principal_key_id": {"$ref": "#/$defs/shortIdentifier"},
        "principal_signing_key_format": {"enum": ["RAW_BASE64URL", "PKCS8_PEM"]}, "service_subject": {"$ref": "#/$defs/identifier"},
        "assertion_ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "accepted_strong_auth_acrs": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "maximum_authentication_age_seconds": {"type": "integer", "minimum": 30, "maximum": 86400}
