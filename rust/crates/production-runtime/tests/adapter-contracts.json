    {"condition_id": "MODEL_GENERATION_STREAM_DLP_BILLING_RESIDENCY", "probes": [{"path": "rust/crates/production-runtime/src/adapters.rs", "test": "parses_real_sse_chunks_and_usage"}, {"path": "rust/crates/model-gateway/src/lib.rs", "test": "secrets_and_concurrent_overspend_are_denied"}]},
