    {"condition_id": "OPCUA_MQTT_MODBUS_REAL_ENDPOINTS", "probes": [{"path": "python/production_gates/tests/test_industrial_protocols.py", "test": "test_digest_bound_mtls_read_receipt_passes_without_value_or_credentials"}]},
    {"condition_id": "SUPERVISED_PHYSICAL_WRITE", "probes": [{"path": "rust/crates/integration-tests/tests/industrial_control_loop.rs", "test": "industrial_prepare_authorize_proxy_execute_and_ledger_finalize"}]},
    {"condition_id": "MULTIZONE_CONTROL_PLANE_TOPOLOGY", "probes": [{"path": "python/platform_sre/tests/test_multizone_topology_gate.py", "test": "test_three_zone_ready_hardened_workload_passes_read_only_gate"}]},
