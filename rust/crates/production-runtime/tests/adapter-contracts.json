    {"condition_id": "WORKLOAD_MTLS_CA", "probes": [{"path": "python/production_gates/tests/test_external_services.py", "test": "test_mtls_requires_private_permissions_and_reports_only_digests"}]},
    {"condition_id": "SECRET_BROKER_DYNAMIC_LEASES", "probes": [{"path": "python/production_gates/tests/test_external_services.py", "test": "test_vault_health_token_and_dynamic_lease_lifecycle"}]},
    {"condition_id": "DEDICATED_LINUX_GVISOR", "probes": [{"path": "rust/crates/sandbox-runtime/src/lib.rs", "test": "macos_cannot_claim_gvisor_production_isolation"}], "runtime_symbols": [{"path": "scripts/run-linux-isolation-gate.sh", "symbols": ["AGENT_TRUST_RUNSC_BINARY", "--runtime runsc", "production_evidence=true"]}]},
