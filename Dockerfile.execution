ARG RUST_BUILDER_IMAGE
ARG RUNTIME_BASE_IMAGE
FROM ${RUST_BUILDER_IMAGE} AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY rust ./rust
RUN cargo build --locked --release -p agent-trust-production-runtime --bin agent-trust-execution-service

FROM ${RUNTIME_BASE_IMAGE}
COPY --from=build /src/target/release/agent-trust-execution-service /usr/local/bin/agent-trust-execution-service
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/agent-trust-execution-service"]
CMD ["--listen", "0.0.0.0", "--port", "8083", "--management-listen", "0.0.0.0", "--management-port", "9093"]
