# syntax=docker/dockerfile:1.7
ARG RUST_BUILDER_IMAGE
ARG RUNTIME_BASE_IMAGE
FROM ${RUST_BUILDER_IMAGE} AS build
WORKDIR /workspace
COPY Cargo.toml Cargo.lock ./
COPY rust ./rust
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/workspace/target,sharing=locked \
    cargo build --locked --release --package agent-trust-model-gateway \
      --bin agenttrust-model-gateway-service && \
    install -D -m 0555 /workspace/target/release/agenttrust-model-gateway-service \
      /out/agenttrust-model-gateway-service

FROM ${RUNTIME_BASE_IMAGE}
COPY --from=build /out/agenttrust-model-gateway-service /usr/local/bin/agenttrust-model-gateway-service
USER 65532:65532
EXPOSE 8091 9101
ENTRYPOINT ["/usr/local/bin/agenttrust-model-gateway-service"]
