{
  "schema_version": "agenttrust.runtime-anomaly-service-config.v1",
  "profile": "production",
  "fail_closed": true,
  "data_address": "0.0.0.0",
  "data_port": 8094,
  "management_address": "0.0.0.0",
  "management_port": 9104,
  "management_routes": ["/live", "/ready"],
  "management_network_policy_required": true,
  "tls_minimum_version": "1.3",
  "client_certificate_required": true,
  "exact_single_san_required": true,
  "route_scopes": [
    "runtime-anomaly:signal",
    "runtime-anomaly:mutate",
    "runtime-anomaly:execute",
    "runtime-anomaly:query"
  ],
  "deterministic_rules_required": true,
  "semantic_detector_required": false,
  "semantic_detector_can_kill": false,
  "maximum_signal_clock_skew_seconds": 120,
  "maximum_signal_lookback": 512,
  "maximum_request_bytes": 1048576,
  "maximum_response_bytes": 1048576,
  "maximum_concurrency": 512,
  "execution_lease_seconds": 60,
  "recovery_interval_seconds": 15,
  "dependencies": {
    "orchestrator": { "readiness_schema": "agenttrust.orchestrator-readiness.v1" },
    "supervisor": { "readiness_schema": "agenttrust.supervisor-readiness.v1" },
    "credential_authority": { "readiness_schema": "agenttrust.credential-authority-readiness.v1" },
    "incident_authority": { "readiness_schema": "agenttrust.incident-authority-readiness.v1" },
    "evidence_authority": {
      "readiness_schema": "agenttrust.evidence-readiness.v1",
      "route": "/v1/evidence/authority-events",
      "scope": "evidence:authority-event",
      "exact_client_identity_required": true,
      "historical_verification_keyring_required": true
    }
  },
  "external_gate_status": "NOT_RUN",
  "production_certification": false
}
