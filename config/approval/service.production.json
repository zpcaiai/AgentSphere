{
  "schema_version": "agenttrust.enterprise-approval-config.v1",
  "profile": "production",
  "fail_closed": true,
  "require_strong_auth": true,
  "require_role_recheck_at_consumption": true,
  "require_signed_review_evidence": true,
  "review_evidence_receipt_schema": "agenttrust.signed-authority-evidence-receipt.v1",
  "review_evidence_event_type": "APPROVAL_REVIEW_PREPARED",
  "require_authority_request_digest_recomputation": true,
  "approval_service_can_sign_review_evidence": false,
  "require_canonical_action_risk_package_snapshot_binding": true,
  "legacy_mutable_cases_allowed": false,
  "deployment_upgrade_strategy": "RECREATE_V2",
  "ui_can_issue_grants": false,
  "maximum_pending_cases_per_tenant": 10000,
  "notification_failure_auto_approves": false,
  "break_glass_maximum_ttl_seconds": 300,
  "post_review_sla_seconds": 86400
}
