{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.example/schemas/tool-proxy/target-profiles.schema.json",
  "title": "Signed, fixed Tool Proxy target profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issuer", "key_id", "key_usage", "profiles", "signature"],
  "properties": {
    "schema_version": {"const": "agenttrust.tool-proxy-target-profiles.v1"},
    "issuer": {"$ref": "#/$defs/identifier"},
    "key_id": {"$ref": "#/$defs/identifier"},
    "key_usage": {"const": "TOOL_PROXY_TARGET_PROFILES"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/profile"}
    },
    "signature": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9_-]+$"}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "target_profile", "credential_profile", "executor_profile", "lease_path", "secret_field", "base_url", "pinned_addresses", "operations"],
      "properties": {
        "tenant_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f-]{36}$"},
        "target_profile": {"$ref": "#/$defs/identifier"},
        "credential_profile": {"$ref": "#/$defs/identifier"},
        "executor_profile": {"$ref": "#/$defs/identifier"},
        "lease_path": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._/-]+$"},
        "secret_field": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
        "base_url": {"type": "string", "format": "uri", "pattern": "^https://[^/?#]+/$"},
        "pinned_addresses": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "format": "ip"}},
        "operations": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 128,
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "path", "content_type"],
            "properties": {
              "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
              "path": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^/(?!.*\\.\\.)(?!.*[%\\\\?#]).*$"},
              "content_type": {"const": "application/json"}
            }
          }
        }
      }
    }
  }
}
