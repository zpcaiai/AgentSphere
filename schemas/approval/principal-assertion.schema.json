{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/signed-approval-principal-assertion.schema.json",
  "title": "Request-bound signed human approval principal assertion",
  "description": "Ed25519 assertion with expires_at after issued_at and no more than 300 seconds later; the verifier also enforces current-time and 30-second future clock-skew bounds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "subject",
    "roles",
    "owned_resources",
    "strong_auth",
    "issuer",
    "audience",
    "issued_at",
    "expires_at",
    "jti",
    "request_digest",
    "client_identity",
    "scope",
    "key_id",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "agenttrust.signed-approval-principal-assertion.v1"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "subject": {
      "$ref": "#/$defs/identifier"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "owned_resources": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "strong_auth": {
      "const": true
    },
    "issuer": {
      "$ref": "#/$defs/identifier"
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "jti": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "client_identity": {
      "type": "string",
      "minLength": 5,
      "maxLength": 512,
      "pattern": "^(DNS|URI):.+$"
    },
    "scope": {
      "enum": [
        "approvals:request",
        "approvals:decide",
        "approvals:issue",
        "approvals:revoke"
      ]
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.:/@-]+$"
    }
  }
}
