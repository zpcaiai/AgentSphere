{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/approval-review-evidence-keyring.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "keys"],
  "properties": {
    "schema_version": {"const": "agenttrust.approval-review-evidence-keyring.v2"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issuer", "key_id", "source_services", "algorithm", "usage", "status",
          "public_key", "tenant_ids", "not_before", "expires_at"],
        "properties": {
          "issuer": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,255}$"},
          "key_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
          "source_services": {
            "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^(DNS|URI):[A-Za-z0-9._:/@-]{1,252}$"}
          },
          "algorithm": {"const": "Ed25519"},
          "usage": {"const": "AUTHORITY_EVIDENCE_RECEIPT"},
          "status": {"enum": ["ACTIVE", "RETIRED"]},
          "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
          "tenant_ids": {
            "type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true,
            "items": {"type": "string", "format": "uuid"}
          },
          "not_before": {"type": "string", "format": "date-time"},
          "expires_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
