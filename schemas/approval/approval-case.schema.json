{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttrust.local/schemas/approval/approval-case.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "case_id", "request", "policy", "status", "decisions", "created_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "agenttrust.enterprise-approval-case.v2"},
    "case_id": {"type": "string", "minLength": 1},
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["tenant_id", "task_id", "step_id", "action_hash", "plan_hash", "parameter_hash",
        "resource", "resource_version", "policy_version", "environment", "risk", "review_context",
        "review_evidence", "requester_subject", "agent_owner_subject", "justification",
        "requested_ttl_seconds", "requested_uses"],
      "properties": {
        "tenant_id": {"type": "string", "format": "uuid"},
        "task_id": {"type": "string", "format": "uuid"},
        "step_id": {"type": "string", "format": "uuid"},
        "action_hash": {"$ref": "#/$defs/digest"},
        "plan_hash": {"$ref": "#/$defs/digest"},
        "parameter_hash": {"$ref": "#/$defs/digest"},
        "resource": {"type": "string", "minLength": 1, "maxLength": 2048},
        "resource_version": {"type": "string", "minLength": 1, "maxLength": 2048},
        "policy_version": {"type": "string", "minLength": 1, "maxLength": 2048},
        "environment": {"type": "string", "minLength": 1, "maxLength": 2048},
        "risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "review_context": {"$ref": "#/$defs/reviewContext"},
        "review_evidence": {"$ref": "#/$defs/reviewEvidence"},
        "requester_subject": {"type": "string", "minLength": 1, "maxLength": 256},
        "agent_owner_subject": {"type": "string", "minLength": 1, "maxLength": 256},
        "justification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000]*$",
          "description": "Human justification encoded as at most 4096 UTF-8 bytes",
          "x-agenttrust-max-utf8-bytes": 4096
        },
        "requested_ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
        "requested_uses": {"const": 1}
      }
    },
    "policy": {"type": "object"},
    "status": {"enum": ["PENDING", "APPROVED", "REJECTED", "REVOKED", "EXPIRED", "CONSUMED", "POST_REVIEW_REQUIRED"]},
    "decisions": {"type": "array", "items": {"type": "object"}}, "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}, "post_review_due_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "codingDetails": {
      "type": "object", "additionalProperties": false,
      "required": ["diff_artifact_ref", "command_summary", "network_scope", "rollback_summary"],
      "properties": {
        "diff_artifact_ref": {"type": "string", "pattern": "^artifact://sha256/[a-f0-9]{64}$"},
        "command_summary": {"type": "string", "minLength": 1, "maxLength": 2048},
        "network_scope": {"type": "string", "minLength": 1, "maxLength": 1024},
        "rollback_summary": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "industrialDetails": {
      "type": "object", "additionalProperties": false,
      "required": ["current_value", "target_value", "allowed_range", "interlock_summary", "physical_impact"],
      "properties": {
        "current_value": {"type": "string", "minLength": 1, "maxLength": 512},
        "target_value": {"type": "string", "minLength": 1, "maxLength": 512},
        "allowed_range": {"type": "string", "minLength": 1, "maxLength": 512},
        "interlock_summary": {"type": "string", "minLength": 1, "maxLength": 2048},
        "physical_impact": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "reviewContext": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["domain", "details"],
          "properties": {"domain": {"const": "CODING"}, "details": {"$ref": "#/$defs/codingDetails"}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["domain", "details"],
          "properties": {"domain": {"const": "INDUSTRIAL"}, "details": {"$ref": "#/$defs/industrialDetails"}}
        }
      ]
    },
    "reviewMaterial": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "tenant_id", "task_id", "canonical_action_hash", "resource",
        "resource_version", "policy_version", "environment", "risk", "review_context",
        "risk_package_ref", "risk_package_digest", "state_snapshot_ref", "state_snapshot_digest"],
      "properties": {
        "schema_version": {"const": "agenttrust.approval-review-material.v1"},
        "tenant_id": {"type": "string", "format": "uuid"},
        "task_id": {"type": "string", "format": "uuid"},
        "canonical_action_hash": {"$ref": "#/$defs/digest"},
        "resource": {"type": "string", "minLength": 1, "maxLength": 2048},
        "resource_version": {"type": "string", "minLength": 1, "maxLength": 2048},
        "policy_version": {"type": "string", "minLength": 1, "maxLength": 2048},
        "environment": {"type": "string", "minLength": 1, "maxLength": 2048},
        "risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "review_context": {"$ref": "#/$defs/reviewContext"},
        "risk_package_ref": {"$ref": "#/$defs/evidenceRef"},
        "risk_package_digest": {"$ref": "#/$defs/digest"},
        "state_snapshot_ref": {"$ref": "#/$defs/evidenceRef"},
        "state_snapshot_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "reviewEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "material", "authority_request", "receipt"],
      "properties": {
        "schema_version": {"const": "agenttrust.approval-review-evidence-binding.v1"},
        "material": {"$ref": "#/$defs/reviewMaterial"},
        "authority_request": {"$ref": "../evidence/authority-evidence-event-request.schema.json"},
        "receipt": {"$ref": "../evidence/signed-authority-evidence-receipt.schema.json"}
      }
    },
    "evidenceRef": {
      "type": "string", "minLength": 1, "maxLength": 2048,
      "pattern": "^(evidence://|urn:agenttrust:(evidence|ledger-evidence):)[^\\s?#]+$"
    }
  }
}
