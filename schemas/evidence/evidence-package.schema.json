{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/evidence-package.schema.json",
  "title": "AgentTrust Evidence Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "tenant_id", "task_id", "events", "artifacts", "package_hash", "built_at"],
  "properties": {
    "schema_version": {"const": "agenttrust.evidence.v1"},
    "package_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "events": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"$ref": "#/$defs/event"}},
    "artifacts": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/artifact"}},
    "package_hash": {"$ref": "#/$defs/hash"},
    "built_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "event_id", "sequence", "previous_hash", "event_hash", "key_id", "signature", "draft"],
      "properties": {
        "schema_version": {"const": "agenttrust.evidence.v1"}, "event_id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 1}, "previous_hash": {"$ref": "#/$defs/hash"},
        "event_hash": {"$ref": "#/$defs/hash"}, "key_id": {"type": "string", "minLength": 1},
        "signature": {"type": "string", "minLength": 1}, "draft": {"type": "object"}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_ref", "sha256", "media_type", "classification", "retention_seconds", "access_policy", "bytes", "created_at"],
      "properties": {
        "artifact_ref": {"type": "string", "pattern": "^artifact:sha256:[a-f0-9]{64}$"}, "sha256": {"$ref": "#/$defs/hash"},
        "media_type": {"type": "string"}, "classification": {"type": "string"}, "retention_seconds": {"type": "integer", "minimum": 1},
        "access_policy": {"type": "string"}, "bytes": {"type": "integer", "minimum": 1}, "created_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
