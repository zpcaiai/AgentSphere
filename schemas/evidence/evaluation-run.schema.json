{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttrust.local/schemas/evidence/evaluation-run.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "evaluation_id", "tenant_id", "task_id", "idempotency_key", "request_digest", "chain_head", "result", "issuer", "key_id", "key_usage", "signature"],
  "properties": {
    "schema_version": {"const": "agenttrust.evaluation-run.v1"},
    "evaluation_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "task_id": {"type": "string", "format": "uuid"},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,128}$"},
    "request_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "chain_head": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "status", "score_millionths", "hard_gate_results", "findings", "evidence_refs", "evaluator_id", "evaluator_version", "evaluated_at"],
      "properties": {
        "schema_version": {"const": "agenttrust.evaluation.v1"},
        "status": {"enum": ["PASS", "FAIL", "NEEDS_HUMAN", "ROLLED_BACK", "MANUAL_RECOVERY_REQUIRED"]},
        "score_millionths": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "hard_gate_results": {"type": "object", "additionalProperties": {"type": "boolean"}},
        "findings": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 512}},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "string", "maxLength": 2048}},
        "evaluator_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "evaluator_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "evaluated_at": {"type": "string", "format": "date-time"}
      }
    },
    "issuer": {"type": "string", "minLength": 1, "maxLength": 256},
    "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "key_usage": {"const": "EVIDENCE_EVALUATION_RUN"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}
  }
}
