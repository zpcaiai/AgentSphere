{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttrust.local/schemas/evidence/evidence-package-request.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "task_id", "idempotency_key", "expected_chain_head", "requested_at"],
  "properties": {
    "schema_version": {"const": "agenttrust.evidence-package-request.v1"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "task_id": {"type": "string", "format": "uuid"},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,128}$"},
    "expected_chain_head": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "requested_at": {"type": "string", "format": "date-time"}
  }
}
