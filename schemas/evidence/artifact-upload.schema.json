{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttrust.local/schemas/evidence/artifact-upload.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "task_id", "idempotency_key", "media_type", "classification", "retention_until", "access_policy", "content_base64url", "requested_at"],
  "properties": {
    "schema_version": {"const": "agenttrust.evidence-artifact-upload.v1"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "task_id": {"type": "string", "format": "uuid"},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,128}$"},
    "media_type": {"type": "string", "minLength": 1, "maxLength": 256},
    "classification": {"type": "string", "minLength": 1, "maxLength": 64},
    "retention_until": {"type": "string", "format": "date-time"},
    "access_policy": {"type": "string", "minLength": 1, "maxLength": 512},
    "content_base64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "requested_at": {"type": "string", "format": "date-time"}
  }
}
