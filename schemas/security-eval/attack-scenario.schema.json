{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://agentsphere.local/schemas/security-eval/attack-scenario.schema.json",
  "title": "Attack Scenario DSL", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "version", "category", "target", "preconditions", "steps", "expected_controls", "success_criteria", "failure_criteria", "cleanup_steps", "seed"],
  "properties": {
    "schema_version": {"const": "agenttrust.attack-scenario.v1"}, "scenario_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
    "category": {"enum": ["PROMPT_INJECTION", "TOOL_ABUSE", "CREDENTIAL_THEFT", "DATA_EXFILTRATION", "POLICY_BYPASS", "MEMORY_POISONING", "SUPPLY_CHAIN", "CODING", "INDUSTRIAL", "ENERGY", "MEDICAL", "SENSITIVE_INTERACTION"]},
    "target": {"type": "string", "minLength": 1},
    "preconditions": {"$ref": "#/$defs/list"}, "steps": {"$ref": "#/$defs/list"}, "expected_controls": {"$ref": "#/$defs/list"},
    "success_criteria": {"$ref": "#/$defs/list"}, "failure_criteria": {"$ref": "#/$defs/list"}, "cleanup_steps": {"$ref": "#/$defs/list"},
    "seed": {"type": "integer", "minimum": 0}
  },
  "$defs": {"list": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "string", "minLength": 1}}}
}
