{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://agentsphere.local/schemas/domain-packs/industrial-action.schema.json",
  "title": "Industrial Two Phase Action", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "asset_id", "point_id", "stage", "expected_version", "target_value", "before_digest", "target_digest", "prepared_digest", "interlock_digest", "alarm_digest", "approval_set_id", "supervision_id"],
  "properties": {
    "schema_version": {"const": "agenttrust.domain-risk-packs.v1"}, "asset_id": {"type": "string", "format": "uuid"},
    "point_id": {"type": "string", "minLength": 1}, "stage": {"enum": ["SIMULATOR", "DIGITAL_TWIN", "READ_ONLY", "SHADOW", "LIMITED_WRITE"]},
    "expected_version": {"type": "string", "minLength": 1}, "target_value": {"type": "number"},
    "before_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "target_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prepared_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "interlock_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "alarm_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "approval_set_id": {"type": ["string", "null"], "format": "uuid"}, "supervision_id": {"type": ["string", "null"], "format": "uuid"}
  }
}
