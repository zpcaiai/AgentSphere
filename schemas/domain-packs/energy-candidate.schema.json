{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://agentsphere.local/schemas/domain-packs/energy-candidate.schema.json",
  "title": "Energy Candidate Plan", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "asset_id", "algorithm", "algorithm_manifest_digest", "stage", "setpoints_kw", "confidence", "out_of_distribution", "requires_shadow_validation", "constraint_digest", "forecast_digest", "fallback_controller_digest", "fallback_reason", "approval_set_id", "supervision_id"],
  "properties": {
    "schema_version": {"const": "agenttrust.domain-risk-packs.v1"}, "asset_id": {"type": "string", "format": "uuid"}, "algorithm": {"enum": ["MPC", "RL", "CBF", "RULE"]},
    "algorithm_manifest_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "stage": {"enum": ["SIMULATOR", "DIGITAL_TWIN", "READ_ONLY", "SHADOW", "LIMITED_WRITE"]},
    "setpoints_kw": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "number"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "out_of_distribution": {"type": "boolean"},
    "requires_shadow_validation": {"const": true}, "constraint_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "forecast_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "fallback_controller_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fallback_reason": {"type": ["string", "null"], "maxLength": 256},
    "approval_set_id": {"type": ["string", "null"], "format": "uuid"}, "supervision_id": {"type": ["string", "null"], "format": "uuid"}
  }
}
