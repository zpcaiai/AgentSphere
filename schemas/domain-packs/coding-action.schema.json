{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://agentsphere.local/schemas/domain-packs/coding-action.schema.json",
  "title": "Coding Pack Action", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "repository_ref", "base_commit", "branch", "paths", "command_template_id", "requested_network", "dependency_lock_digest", "rollback_ref", "effect_class"],
  "properties": {
    "schema_version": {"const": "agenttrust.domain-risk-packs.v1"}, "repository_ref": {"type": "string", "pattern": "^https://"},
    "base_commit": {"type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"}, "branch": {"type": "string", "pattern": "^agent/[A-Za-z0-9._/-]{1,480}$"},
    "paths": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"}},
    "command_template_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$", "not": {"pattern": "(?i)shell"}},
    "requested_network": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "maxLength": 256}},
    "dependency_lock_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "rollback_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
    "effect_class": {"enum": ["PURE", "IDEMPOTENT", "COMPENSATABLE", "IRREVERSIBLE"]}
  }
}
