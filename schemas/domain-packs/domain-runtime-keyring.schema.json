{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/domain-packs/domain-runtime-keyring.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "keys"],
  "properties": {
    "schema_version": {"const": "agenttrust.domain-runtime-receipt-keyring.v1"},
    "keys": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object", "additionalProperties": false,
      "required": ["key_id", "usage", "public_key", "not_before", "expires_at", "revoked"], "properties": {
        "key_id": {"type": "string", "minLength": 1, "maxLength": 256}, "usage": {"const": "DOMAIN_RUNTIME_RECEIPT"},
        "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"}, "not_before": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}, "revoked": {"const": false}
      }
    }
    }
  }
}
