{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/domain-packs/sensitive-interaction.schema.json",
  "title": "Consent-bound sensitive interaction command",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "conversation_hash", "consent_digest", "relationship_boundary_digest", "source_snapshot_digest", "minimum_safe_context_digest", "risk_level", "ordinary_agent_paused", "citation_digests", "approval_set_id"],
  "properties": {
    "schema_version": {"const": "agenttrust.domain-risk-packs.v1"}, "tenant_id": {"type": "string", "format": "uuid"},
    "conversation_hash": {"$ref": "#/$defs/digest"}, "consent_digest": {"$ref": "#/$defs/digest"},
    "relationship_boundary_digest": {"$ref": "#/$defs/digest"}, "source_snapshot_digest": {"$ref": "#/$defs/digest"},
    "minimum_safe_context_digest": {"$ref": "#/$defs/digest"}, "risk_level": {"enum": ["LOW", "ELEVATED", "HIGH"]},
    "ordinary_agent_paused": {"type": "boolean"}, "citation_digests": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "approval_set_id": {"type": ["string", "null"], "format": "uuid"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
