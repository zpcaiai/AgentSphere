{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agenttrust.dev/security-evaluation/attack-dataset-manifest-v1.schema.json",
  "title": "AgentTrust signed attack dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "version", "samples_digest", "categories", "provenance", "license"],
  "properties": {
    "schema_version": {"const": "agenttrust.attack-dataset-manifest.v1"},
    "dataset_id": {"type": "string", "format": "uuid"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([+-][A-Za-z0-9.-]+)?$", "maxLength": 128},
    "samples_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/category"}
    },
    "provenance": {"type": "string", "minLength": 1, "maxLength": 2048},
    "license": {"type": "string", "minLength": 1, "maxLength": 256},
    "sensitivity": {"enum": ["PUBLIC", "INTERNAL", "RESTRICTED"]},
    "generated_seed": {"type": "integer", "minimum": 0},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    }
  },
  "$defs": {
    "category": {
      "enum": [
        "PROMPT_INJECTION", "GOAL_HIJACK", "TOOL_ABUSE", "CREDENTIAL_MOVEMENT",
        "MEMORY_POISONING", "MCP_DECLARATION_MISMATCH", "A2A_CASCADE", "IDENTITY_SPOOFING",
        "APPROVAL_BYPASS", "SANDBOX_ESCAPE", "SLOW_EXFILTRATION", "CONTEXT_POISONING",
        "CODING", "INDUSTRIAL", "ENERGY", "MEDICAL", "SENSITIVE_INTERACTION", "MARKETPLACE"
      ]
    }
  }
}
