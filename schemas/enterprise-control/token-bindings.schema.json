{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agenttrust.dev/enterprise-control/token-bindings.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bindings"],
  "properties": {
    "schema_version": {"const": "agenttrust.enterprise-token-bindings.v1"},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["client_identity", "tenant_id", "subject", "scope", "token_sha256"],
        "properties": {
          "client_identity": {"type": "string", "pattern": "^(DNS|URI):\\S{1,508}$"},
          "tenant_id": {"type": "string", "format": "uuid"},
          "subject": {"type": "string", "pattern": "^[A-Za-z0-9_.:/@-]{1,256}$"},
          "scope": {"enum": ["enterprise:mutate", "enterprise:execute"]},
          "token_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
