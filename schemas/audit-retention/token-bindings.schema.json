{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttrust.local/schemas/audit-retention/token-bindings.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bindings"],
  "properties": {
    "schema_version": {"const": "agenttrust.audit-token-bindings.v1"},
    "bindings": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["client_identity", "tenant_id", "subject", "scope", "token_sha256"],
        "properties": {
          "client_identity": {"type": "string", "pattern": "^(DNS|URI):.{1,508}$"},
          "tenant_id": {"type": "string", "format": "uuid"},
          "subject": {"type": "string", "minLength": 1, "maxLength": 512},
          "scope": {"enum": ["audit:append", "audit:query", "audit:authoritative-query", "audit:retention", "audit:hold-place", "audit:hold-release", "audit:export", "audit:delete", "audit:control", "audit:graph"]},
          "token_sha256": {"$ref": "api.schema.json#/$defs/digest"}
        }
      }
    }
  }
}
