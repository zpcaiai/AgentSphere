{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/execution/gvisor-worker-keyring.schema.json",
  "title": "Production gVisor worker verification keyring",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment", "keys"],
  "properties": {
    "schema_version": {"const": "agenttrust.gvisor-worker-keyring.v1"},
    "environment": {"const": "production"},
    "keys": {
      "type": "array",
      "minItems": 5,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/key"}
    }
  },
  "$defs": {
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "issuer", "key_usage", "public_key", "valid_from", "expires_at", "revoked"],
      "properties": {
        "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
        "issuer": {"type": "string", "minLength": 1, "maxLength": 256},
        "key_usage": {"enum": ["PEP_EXECUTION_AUTHORIZATION", "AGENTTRUST_GVISOR_JOB_DISPATCH_V1", "AGENTTRUST_GVISOR_RUNTIME_ATTESTATION_V1", "AGENTTRUST_GVISOR_REGISTRY_ATTESTATION_V1", "AGENTTRUST_GVISOR_EXECUTION_RECEIPT_V1"]},
        "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
        "valid_from": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "revoked": {"type": "boolean"}
      }
    }
  }
}
