{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.example/schemas/identity/workload-credential.schema.json",
  "title": "Workload Credential Authority contracts",
  "$defs": {
    "uuid": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:/-]+$"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "idempotency_key", "credential_id", "tenant_id", "agent_instance_id", "task_id", "step_id", "action_hash", "policy_decision_id", "tool_id", "credential_profile", "operation", "resource", "target_profile", "audience", "revocation_epoch", "issued_at", "expires_at", "max_uses"],
      "properties": {
        "schema_version": {"const": "agenttrust.workload-credential-claims.v1"},
        "idempotency_key": {"$ref": "#/$defs/idempotencyKey"},
        "credential_id": {"$ref": "#/$defs/uuid"},
        "tenant_id": {"$ref": "#/$defs/uuid"},
        "agent_instance_id": {"$ref": "#/$defs/uuid"},
        "task_id": {"$ref": "#/$defs/uuid"},
        "step_id": {"$ref": "#/$defs/uuid"},
        "action_hash": {"$ref": "#/$defs/digest"},
        "policy_decision_id": {"$ref": "#/$defs/identifier"},
        "tool_id": {"$ref": "#/$defs/identifier"},
        "credential_profile": {"$ref": "#/$defs/identifier"},
        "operation": {"$ref": "#/$defs/identifier"},
        "resource": {"type": "string", "minLength": 1, "maxLength": 2048},
        "target_profile": {"$ref": "#/$defs/identifier"},
        "audience": {"const": "tool-proxy"},
        "revocation_epoch": {"type": "integer", "minimum": 0},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "max_uses": {"const": 1}
      }
    },
    "bindingRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "idempotency_key", "tenant_id", "agent_instance_id", "task_id", "step_id", "action_hash", "policy_decision_id", "tool_id", "credential_profile", "operation", "resource", "target_profile", "audience", "revocation_epoch", "ttl_seconds", "max_uses"],
      "properties": {
        "schema_version": {"const": "agenttrust.credential-binding-request.v1"},
        "idempotency_key": {"$ref": "#/$defs/idempotencyKey"},
        "tenant_id": {"$ref": "#/$defs/uuid"},
        "agent_instance_id": {"$ref": "#/$defs/uuid"},
        "task_id": {"$ref": "#/$defs/uuid"},
        "step_id": {"$ref": "#/$defs/uuid"},
        "action_hash": {"$ref": "#/$defs/digest"},
        "policy_decision_id": {"$ref": "#/$defs/identifier"},
        "tool_id": {"$ref": "#/$defs/identifier"},
        "credential_profile": {"$ref": "#/$defs/identifier"},
        "operation": {"$ref": "#/$defs/identifier"},
        "resource": {"type": "string", "minLength": 1, "maxLength": 2048},
        "target_profile": {"$ref": "#/$defs/identifier"},
        "audience": {"const": "tool-proxy"},
        "revocation_epoch": {"type": "integer", "minimum": 0},
        "ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "max_uses": {"const": 1}
      }
    },
    "bindingReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "credential_handle_sha256", "claims", "claims_digest", "issuer", "key_id", "key_usage", "signature"],
      "properties": {
        "schema_version": {"const": "agenttrust.credential-binding-receipt.v1"},
        "credential_handle_sha256": {"$ref": "#/$defs/digest"},
        "claims": {"$ref": "#/$defs/claims"},
        "claims_digest": {"$ref": "#/$defs/digest"},
        "issuer": {"$ref": "#/$defs/identifier"},
        "key_id": {"$ref": "#/$defs/identifier"},
        "key_usage": {"const": "WORKLOAD_CREDENTIAL_BINDING"},
        "signature": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9_-]+$"}
      }
    },
    "issuance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload_credential", "binding_receipt"],
      "properties": {
        "workload_credential": {"type": "string", "pattern": "^wca_[A-Za-z0-9_-]{43}$"},
        "binding_receipt": {"$ref": "#/$defs/bindingReceipt"}
      }
    },
    "consumptionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "idempotency_key", "credential_handle", "binding_receipt", "tenant_id", "agent_instance_id", "task_id", "step_id", "action_hash", "policy_decision_id", "tool_id", "credential_profile", "operation", "resource", "target_profile", "audience", "revocation_epoch", "claims_digest"],
      "properties": {
        "schema_version": {"const": "agenttrust.credential-consumption-request.v1"},
        "idempotency_key": {"$ref": "#/$defs/idempotencyKey"},
        "credential_handle": {"type": "string", "pattern": "^wca_[A-Za-z0-9_-]{43}$"},
        "binding_receipt": {"$ref": "#/$defs/bindingReceipt"},
        "tenant_id": {"$ref": "#/$defs/uuid"},
        "agent_instance_id": {"$ref": "#/$defs/uuid"},
        "task_id": {"$ref": "#/$defs/uuid"},
        "step_id": {"$ref": "#/$defs/uuid"},
        "action_hash": {"$ref": "#/$defs/digest"},
        "policy_decision_id": {"$ref": "#/$defs/identifier"},
        "tool_id": {"$ref": "#/$defs/identifier"},
        "credential_profile": {"$ref": "#/$defs/identifier"},
        "operation": {"$ref": "#/$defs/identifier"},
        "resource": {"type": "string", "minLength": 1, "maxLength": 2048},
        "target_profile": {"$ref": "#/$defs/identifier"},
        "audience": {"const": "tool-proxy"},
        "revocation_epoch": {"type": "integer", "minimum": 0},
        "claims_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "consumptionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "idempotency_key", "consumption_id", "credential_id", "tenant_id", "action_hash", "audience", "revocation_epoch", "claims_digest", "scope_digest", "consumed_at", "remaining_uses", "issuer", "key_id", "key_usage", "signature"],
      "properties": {
        "schema_version": {"const": "agenttrust.credential-consumption-receipt.v1"},
        "idempotency_key": {"$ref": "#/$defs/idempotencyKey"},
        "consumption_id": {"$ref": "#/$defs/uuid"},
        "credential_id": {"$ref": "#/$defs/uuid"},
        "tenant_id": {"$ref": "#/$defs/uuid"},
        "action_hash": {"$ref": "#/$defs/digest"},
        "audience": {"const": "tool-proxy"},
        "revocation_epoch": {"type": "integer", "minimum": 0},
        "claims_digest": {"$ref": "#/$defs/digest"},
        "scope_digest": {"$ref": "#/$defs/digest"},
        "consumed_at": {"type": "string", "format": "date-time"},
        "remaining_uses": {"const": 0},
        "issuer": {"$ref": "#/$defs/identifier"},
        "key_id": {"$ref": "#/$defs/identifier"},
        "key_usage": {"const": "WORKLOAD_CREDENTIAL_CONSUMPTION"},
        "signature": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9_-]+$"}
      }
    },
    "lifecycleRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version"],
      "properties": {
        "schema_version": {"const": "agenttrust.credential-lifecycle.v1"},
        "reason_code": {"type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"}
      }
    },
    "lifecycleReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation", "subject_kind", "subject_id", "tenant_id", "state", "revocation_epoch", "event_ref", "changed"],
      "properties": {
        "schema_version": {"const": "agenttrust.credential-lifecycle.v1"},
        "operation": {"enum": ["REVOKE_CREDENTIAL", "REVOKE_TASK", "PAUSE_TASK", "UNFREEZE_TASK", "CANCEL_TASK", "KILL_TASK", "REVOKE_AGENT", "REVOKE_TENANT"]},
        "subject_kind": {"enum": ["credential", "task", "agent", "tenant"]},
        "subject_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "tenant_id": {"$ref": "#/$defs/uuid"},
        "state": {"enum": ["ACTIVE", "PAUSED", "CANCELED", "KILLED", "REVOKED"]},
        "revocation_epoch": {"type": "integer", "minimum": 0},
        "event_ref": {"type": "string", "pattern": "^identity-event://"},
        "changed": {"type": "boolean"}
      }
    },
    "authoritativeCredentialView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "credential_id", "agent_instance_id", "task_id", "step_id", "action_hash", "audience", "tool_id", "credential_profile", "resource", "target_profile", "claims_digest", "binding_receipt_digest", "status", "remaining_uses", "revocation_epoch", "issued_at", "expires_at", "revoked_at"],
      "properties": {
        "schema_version": {"const": "agenttrust.credential-view.v1"},
        "credential_id": {"$ref": "#/$defs/uuid"},
        "agent_instance_id": {"$ref": "#/$defs/uuid"},
        "task_id": {"$ref": "#/$defs/uuid"},
        "step_id": {"$ref": "#/$defs/uuid"},
        "action_hash": {"$ref": "#/$defs/digest"},
        "audience": {"const": "tool-proxy"},
        "tool_id": {"$ref": "#/$defs/identifier"},
        "credential_profile": {"$ref": "#/$defs/identifier"},
        "resource": {"type": "string", "minLength": 1, "maxLength": 2048},
        "target_profile": {"$ref": "#/$defs/identifier"},
        "claims_digest": {"$ref": "#/$defs/digest"},
        "binding_receipt_digest": {"$ref": "#/$defs/digest"},
        "status": {"enum": ["ACTIVE", "CONSUMED", "EXPIRED", "REVOKED"]},
        "remaining_uses": {"type": "integer", "minimum": 0, "maximum": 1},
        "revocation_epoch": {"type": "integer", "minimum": 0},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "revoked_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "authoritativeCredentialPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "authoritative", "tenant_id", "resource", "items", "next_cursor", "data_digest"],
      "properties": {
        "schema_version": {"const": "agenttrust.authoritative-credential-page.v1"},
        "authoritative": {"const": true},
        "tenant_id": {"$ref": "#/$defs/uuid"},
        "resource": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[a-z][a-z0-9_-]{0,99}$"},
        "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/authoritativeCredentialView"}},
        "next_cursor": {"type": "null"},
        "data_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "ready"],
      "properties": {
        "schema_version": {"const": "agenttrust.identity-credential-readiness.v1"},
        "ready": {"type": "boolean"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "error"],
      "properties": {
        "schema_version": {"const": "agenttrust.identity.v1"},
        "error": {"type": "string", "pattern": "^IDENTITY_[A-Z0-9_]+$"}
      }
    }
  }
}
