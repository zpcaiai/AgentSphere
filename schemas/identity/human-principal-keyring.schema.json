{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agenttrust.dev/identity/human-principal-keyring.schema.json",
  "title": "Human principal assertion verification keyring",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audience", "keys"],
  "properties": {
    "schema_version": {"const": "agenttrust.human-principal-keyring.v1"},
    "audience": {"type": "string", "minLength": 1, "maxLength": 256},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issuer", "key_id", "algorithm", "usage", "status", "public_key",
          "tenant_ids", "not_before", "expires_at"
        ],
        "properties": {
          "issuer": {"type": "string", "pattern": "^[A-Za-z0-9_.:/@-]{1,256}$"},
          "key_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:/@-]{1,128}$"},
          "algorithm": {"const": "Ed25519"},
          "usage": {"const": "HUMAN_PRINCIPAL_ASSERTION"},
          "status": {"enum": ["ACTIVE", "VERIFY_ONLY"]},
          "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
          "tenant_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "uniqueItems": true,
            "items": {"type": "string", "format": "uuid"}
          },
          "not_before": {"type": "string", "format": "date-time"},
          "expires_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
