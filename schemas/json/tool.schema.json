{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttrust.local/schemas/tool.schema.json",
  "title": "Agent Trust ToolManifest",
  "description": "Wire contract for agent_trust_registry::ToolManifest. The manifest itself is strict; input_schema and output_schema are JSON Schema documents validated by the Registry before activation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_id",
    "tool_version",
    "status",
    "domain",
    "display_name",
    "description",
    "input_schema",
    "output_schema",
    "effect_class",
    "risk_level",
    "executor_profile",
    "credential_profile",
    "approval_profile",
    "limits",
    "network_profile_ref",
    "filesystem_profile_ref",
    "implementation",
    "allowed_tenants"
  ],
  "properties": {
    "schema_version": {"const": "agenttrust.registry.v1"},
    "tool_id": {"$ref": "#/$defs/tool_id"},
    "tool_version": {"$ref": "#/$defs/semver"},
    "status": {"enum": ["DRAFT", "VALIDATED", "SIGNED", "ACTIVE", "DEPRECATED", "REVOKED"]},
    "domain": {"$ref": "#/$defs/domain"},
    "display_name": {"$ref": "#/$defs/display_name"},
    "description": {"$ref": "#/$defs/description"},
    "input_schema": {"$ref": "#/$defs/json_schema_document"},
    "output_schema": {"$ref": "#/$defs/json_schema_document"},
    "effect_class": {"enum": ["PURE", "IDEMPOTENT", "COMPENSATABLE", "IRREVERSIBLE"]},
    "risk_level": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "executor_profile": {"$ref": "#/$defs/profile_ref"},
    "credential_profile": {"$ref": "#/$defs/profile_ref"},
    "approval_profile": {"$ref": "#/$defs/profile_ref"},
    "compensation": {"$ref": "#/$defs/compensation"},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_ms", "max_result_bytes"],
      "properties": {
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 86400000},
        "max_result_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824}
      }
    },
    "network_profile_ref": {"$ref": "#/$defs/profile_ref"},
    "filesystem_profile_ref": {"$ref": "#/$defs/profile_ref"},
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest", "executor_id"],
      "properties": {
        "kind": {"enum": ["wasm_component", "oci_container", "internal_service", "http_proxy", "mcp_server", "industrial_gateway"]},
        "digest": {"$ref": "#/$defs/sha256_digest"},
        "executor_id": {"$ref": "#/$defs/profile_ref"}
      }
    },
    "allowed_tenants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    },
    "signature": {"$ref": "#/$defs/manifest_signature"}
  },
  "allOf": [
    {
      "if": {"properties": {"effect_class": {"const": "PURE"}}, "required": ["effect_class"]},
      "then": {"properties": {"credential_profile": {"const": "none"}}}
    },
    {
      "if": {"properties": {"effect_class": {"const": "COMPENSATABLE"}}, "required": ["effect_class"]},
      "then": {"required": ["compensation"], "properties": {"compensation": {"type": "object"}}}
    },
    {
      "if": {"properties": {"effect_class": {"const": "IRREVERSIBLE"}}, "required": ["effect_class"]},
      "then": {
        "properties": {
          "risk_level": {"enum": ["HIGH", "CRITICAL"]},
          "approval_profile": {"not": {"const": "none"}}
        }
      }
    }
  ],
  "$defs": {
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "tool_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "semver": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "profile_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sha256_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "tool_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_id", "tool_version"],
      "properties": {
        "tool_id": {"$ref": "#/$defs/tool_id"},
        "tool_version": {"$ref": "#/$defs/semver"}
      }
    },
    "compensation": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "precondition_kind"],
          "properties": {
            "tool": {"$ref": "#/$defs/tool_ref"},
            "precondition_kind": {"$ref": "#/$defs/profile_ref"}
          }
        }
      ]
    },
    "manifest_signature_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher_id", "key_id", "algorithm", "signature"],
      "properties": {
        "publisher_id": {"$ref": "#/$defs/identifier"},
        "key_id": {"$ref": "#/$defs/identifier"},
        "algorithm": {"const": "Ed25519"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    },
    "manifest_signature": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/manifest_signature_value"}
      ]
    },
    "json_schema_document": {
      "type": "object",
      "minProperties": 1,
      "description": "A local JSON Schema 2020-12 document. Registry activation accepts only fragment-local reference keywords; object-typed data nodes must set additionalProperties to false.",
      "properties": {
        "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"}
      },
      "additionalProperties": true
    }
  }
}
