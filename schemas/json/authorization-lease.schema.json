{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://agenttrust.local/schemas/authorization-lease.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","lease_id","task_id","goal_hash","plan_hash","policy_snapshot","allowed_tools","allowed_resources","revocation_epoch","valid_until"],
  "properties":{
    "schema_version":{"const":"agenttrust.contracts.v1"},
    "lease_id":{"$ref":"common.schema.json#/$defs/uuid"},
    "task_id":{"$ref":"common.schema.json#/$defs/uuid"},
    "goal_hash":{"$ref":"common.schema.json#/$defs/hash"},
    "plan_hash":{"$ref":"common.schema.json#/$defs/hash"},
    "policy_snapshot":{"type":"string","minLength":1,"maxLength":512},
    "allowed_tools":{"type":"array","uniqueItems":true,"maxItems":1000,"items":{"$ref":"common.schema.json#/$defs/tool_ref"}},
    "allowed_resources":{"type":"array","uniqueItems":true,"maxItems":10000,"items":{"type":"string","minLength":1,"maxLength":2048}},
    "revocation_epoch":{"type":"integer","minimum":0},
    "valid_until":{"$ref":"common.schema.json#/$defs/timestamp"}
  }
}
