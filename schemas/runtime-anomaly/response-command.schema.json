{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agenttrust.dev/runtime-anomaly/response-command.schema.json",
  "title": "Signed Continuous Authorization Response Command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "response_id", "tenant_id", "task_id", "adjustment",
    "new_revocation_epoch", "reason_codes", "evidence_digest", "recovery_conditions",
    "issued_at", "expires_at", "issuer", "key_id", "signature"
  ],
  "properties": {
    "schema_version": { "const": "agenttrust.runtime-anomaly.v1" },
    "response_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "task_id": { "type": "string", "format": "uuid" },
    "adjustment": {
      "enum": [
        "NO_CHANGE", "REQUIRE_APPROVAL", "REDUCE_SCOPE", "PAUSE",
        "REVOKE_LEASE", "REVOKE_CREDENTIAL", "KILL"
      ]
    },
    "new_revocation_epoch": { "type": "integer", "minimum": 0 },
    "reason_codes": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "evidence_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "recovery_conditions": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "issuer": { "type": "string", "minLength": 1, "maxLength": 256 },
    "key_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "signature": { "type": "string", "minLength": 80, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" }
  }
}
