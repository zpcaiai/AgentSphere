{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agenttrust.dev/runtime-anomaly/controlled-response-receipt.schema.json",
  "title": "Governed Runtime Response Downstream Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "response_id", "command_digest", "receipt_digest", "safe_status"
  ],
  "properties": {
    "schema_version": { "const": "agenttrust.controlled-runtime-response-receipt.v1" },
    "response_id": { "type": "string", "format": "uuid" },
    "command_digest": { "$ref": "#/$defs/digest" },
    "receipt_digest": { "$ref": "#/$defs/digest" },
    "safe_status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
