{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://agentsphere.local/schemas/agent-registry/agent-bom.schema.json",
  "title": "Agent Bill of Materials", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "agent_id", "owner_subject", "sponsor_subject", "environment", "lifecycle", "components", "bom_digest"],
  "properties": {
    "schema_version": {"const": "agenttrust.agent-bom.v1"}, "tenant_id": {"type": "string", "minLength": 1}, "agent_id": {"type": "string", "minLength": 1},
    "owner_subject": {"type": "string", "minLength": 1}, "sponsor_subject": {"type": "string", "minLength": 1}, "environment": {"type": "string", "minLength": 1},
    "lifecycle": {"enum": ["DRAFT", "ACTIVE", "SUSPENDED", "RETIRED", "REVOKED"]},
    "components": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "object", "required": ["kind", "name", "version", "digest"], "properties": {"kind": {"type": "string"}, "name": {"type": "string"}, "version": {"type": "string"}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}},
    "bom_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
