{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/agent-registry/agent-bom.schema.json",
  "title": "Agent Bill of Materials",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "agent_id", "components", "bom_digest", "generated_at"],
  "properties": {
    "schema_version": {"const": "agenttrust.agent-bom.v1"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "agent_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
    "components": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "name", "version", "digest", "supply_chain_digest"],
        "properties": {
          "kind": {"enum": ["MODEL", "TOOL", "PACK", "PROMPT", "MEMORY", "KNOWLEDGE", "RUNTIME", "MCP_SERVER"]},
          "name": {"type": "string", "minLength": 1, "maxLength": 256},
          "version": {"type": "string", "minLength": 1, "maxLength": 256},
          "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "supply_chain_digest": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-f0-9]{64}$"}]}
        },
        "allOf": [{
          "if": {"properties": {"kind": {"const": "PACK"}}},
          "then": {"properties": {"supply_chain_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
        }]
      }
    },
    "bom_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
