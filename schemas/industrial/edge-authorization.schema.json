{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/industrial/edge-authorization.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authorization_id", "tenant_id", "action_hash", "arguments_digest", "resource_key", "purpose", "expected_resource_version", "approval_ids", "central_policy_version", "maximum_risk", "issued_at", "expires_at", "issuer", "key_id", "key_usage", "signature"],
  "properties": {
    "schema_version": {"const": "agenttrust.industrial-edge.v1"},
    "authorization_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "action_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "arguments_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "resource_key": {"type": "string", "minLength": 1, "maxLength": 1280},
    "purpose": {"enum": ["WRITE", "SAFE_STOP"]},
    "expected_resource_version": {"type": "string", "minLength": 1, "maxLength": 256},
    "approval_ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "central_policy_version": {"type": "string", "minLength": 1, "maxLength": 256},
    "maximum_risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "issuer": {"type": "string", "minLength": 1, "maxLength": 256},
    "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "key_usage": {"const": "INDUSTRIAL_EDGE_AUTHORIZATION"},
    "signature": {"type": "string", "minLength": 86, "maxLength": 86, "pattern": "^[A-Za-z0-9_-]+$"}
  }
}
