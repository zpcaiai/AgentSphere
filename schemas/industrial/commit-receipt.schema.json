{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/industrial/commit-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "preparation_id", "tenant_id", "action_hash", "authorization_id", "central_policy_version", "local_policy_version", "before", "after", "convergence", "verified", "dispatch_journal_digest", "journal_digest", "committed_at"],
  "properties": {
    "schema_version": {"const": "agenttrust.industrial-edge.v1"},
    "preparation_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "action_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authorization_id": {"type": "string", "format": "uuid"},
    "central_policy_version": {"type": "string", "minLength": 1, "maxLength": 256},
    "local_policy_version": {"type": "string", "minLength": 1, "maxLength": 256},
    "before": {"$ref": "telemetry-sample.schema.json"},
    "after": {"$ref": "telemetry-sample.schema.json"},
    "convergence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_value", "sample_count", "stable_sample_count", "maximum_observed_error", "oscillations", "first_sequence", "last_sequence", "converged"],
      "properties": {
        "target_value": {"type": "number"},
        "sample_count": {"type": "integer", "minimum": 1, "maximum": 1024},
        "stable_sample_count": {"type": "integer", "minimum": 1, "maximum": 1024},
        "maximum_observed_error": {"type": "number", "minimum": 0},
        "oscillations": {"type": "integer", "minimum": 0},
        "first_sequence": {"type": "integer", "minimum": 0},
        "last_sequence": {"type": "integer", "minimum": 0},
        "converged": {"const": true}
      }
    },
    "verified": {"const": true},
    "dispatch_journal_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "journal_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "committed_at": {"type": "string", "format": "date-time"}
  }
}
