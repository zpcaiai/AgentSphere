{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttrust.local/schemas/registry/token-bindings.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bindings"],
  "properties": {
    "schema_version": {"const": "agenttrust.registry-token-bindings.v1"},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["client_identity", "tenant_id", "subject", "scope", "token_sha256"],
        "properties": {
          "client_identity": {"type": "string", "pattern": "^(?:DNS:[A-Za-z0-9.-]+|URI:spiffe://[A-Za-z0-9.-]+/.+)$", "maxLength": 512},
          "tenant_id": {"type": "string", "format": "uuid"},
          "subject": {"type": "string", "minLength": 1, "maxLength": 256},
          "scope": {"enum": ["registry:read", "registry:write"]},
          "token_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
