{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/retention/audit-export.schema.json",
  "title": "Signed Audit Export",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "export_id", "chain_head", "artifact_digests", "manifest_digest", "key_id", "signature", "created_at"],
  "properties": {
    "schema_version": {"const": "agenttrust.audit-export.v1"},
    "tenant_id": {"type": "string", "minLength": 1},
    "export_id": {"type": "string", "minLength": 1},
    "chain_head": {"$ref": "#/$defs/hash"},
    "artifact_digests": {"type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
    "manifest_digest": {"$ref": "#/$defs/hash"},
    "key_id": {"type": "string", "minLength": 1},
    "signature": {"type": "string", "minLength": 16},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
