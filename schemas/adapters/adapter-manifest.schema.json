{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/adapter-manifest.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "adapter_id", "adapter_version", "protocol", "entrypoint_digest", "permissions", "network_profiles", "schema_hashes", "version_bundles", "publisher_key_id", "signature"],
  "properties": {
    "schema_version": {"const": "agenttrust.adapter.v1"}, "adapter_id": {"type": "string", "minLength": 1},
    "adapter_version": {"type": "string", "minLength": 1}, "protocol": {"type": "string", "minLength": 1},
    "entrypoint_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "permissions": {"type": "array", "uniqueItems": true, "items": {"enum": ["SUBMIT_IR", "RETURN_RESULT", "NETWORK_PROFILE", "READ_CONFIG"]}},
    "network_profiles": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "schema_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "version_bundles": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "publisher_key_id": {"type": "string", "minLength": 1}, "signature": {"type": "string", "minLength": 1}
  }
}
