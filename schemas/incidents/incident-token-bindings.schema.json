{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/incidents/incident-token-bindings.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bindings"],
  "properties": {
    "schema_version": {"const": "agenttrust.incident-token-bindings.v1"},
    "bindings": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "object", "additionalProperties": false, "required": ["client_identity", "tenant_id", "subject", "scope", "token_sha256"], "properties": {"client_identity": {"type": "string", "pattern": "^(DNS|URI):"}, "tenant_id": {"type": "string", "format": "uuid"}, "subject": {"type": "string", "minLength": 1, "maxLength": 256}, "scope": {"enum": ["incident:detect", "incident:mutate", "incident:execute", "incident:query"]}, "token_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
  }
}
