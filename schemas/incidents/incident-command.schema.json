{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/incidents/incident-command.schema.json",
  "title": "Governed incident, replay, and release-gate command",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "command_id", "resource_id", "task_id", "operation", "expected_resource_version", "requested_at", "payload"],
  "properties": {
    "schema_version": {"const": "agenttrust.incident-command.v1"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "command_id": {"type": "string", "format": "uuid"},
    "resource_id": {"type": "string", "pattern": "^(incident:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|release:[A-Za-z0-9][A-Za-z0-9._:/-]*)$", "maxLength": 1024},
    "task_id": {"type": "string", "format": "uuid"},
    "operation": {"enum": ["DETECT", "TRIAGE", "CONTAIN", "INVESTIGATE", "PRESERVE_EVIDENCE", "PLAN_REPLAY", "COMPLETE_REPLAY", "PUBLISH_ROOT_CAUSE", "BEGIN_REMEDIATION", "TRIGGER_RECERTIFICATION", "EVALUATE_RELEASE", "START_CANARY", "RECORD_CANARY", "ROLLBACK_RELEASE", "CLOSE"]},
    "expected_resource_version": {"type": "integer", "minimum": 0},
    "requested_at": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"operation": {"enum": ["EVALUATE_RELEASE", "START_CANARY", "RECORD_CANARY", "ROLLBACK_RELEASE"]}}}, "then": {"properties": {"resource_id": {"pattern": "^release:[A-Za-z0-9][A-Za-z0-9._:/-]*$"}}}, "else": {"properties": {"resource_id": {"pattern": "^incident:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}}}},
    {"if": {"properties": {"operation": {"const": "DETECT"}}}, "then": {"properties": {"resource_id": {"pattern": "^incident:[0-9a-f-]{36}$"}, "expected_resource_version": {"const": 0}, "payload": {"$ref": "#/$defs/detect"}}}},
    {"if": {"properties": {"operation": {"const": "TRIAGE"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/triage"}}}},
    {"if": {"properties": {"operation": {"const": "CONTAIN"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/contain"}}}},
    {"if": {"properties": {"operation": {"enum": ["INVESTIGATE", "BEGIN_REMEDIATION"]}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/reason"}}}},
    {"if": {"properties": {"operation": {"const": "PRESERVE_EVIDENCE"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/preserve"}}}},
    {"if": {"properties": {"operation": {"const": "PLAN_REPLAY"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/replayPlan"}}}},
    {"if": {"properties": {"operation": {"const": "COMPLETE_REPLAY"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/replayRun"}}}},
    {"if": {"properties": {"operation": {"const": "PUBLISH_ROOT_CAUSE"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/rootCause"}}}},
    {"if": {"properties": {"operation": {"const": "TRIGGER_RECERTIFICATION"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/recertification"}}}},
    {"if": {"properties": {"operation": {"const": "EVALUATE_RELEASE"}}}, "then": {"properties": {"resource_id": {"pattern": "^release:"}, "payload": {"$ref": "#/$defs/releaseGate"}}}},
    {"if": {"properties": {"operation": {"const": "START_CANARY"}}}, "then": {"properties": {"resource_id": {"pattern": "^release:"}, "payload": {"$ref": "#/$defs/startCanary"}}}},
    {"if": {"properties": {"operation": {"const": "RECORD_CANARY"}}}, "then": {"properties": {"resource_id": {"pattern": "^release:"}, "payload": {"$ref": "#/$defs/recordCanary"}}}},
    {"if": {"properties": {"operation": {"const": "ROLLBACK_RELEASE"}}}, "then": {"properties": {"resource_id": {"pattern": "^release:"}, "payload": {"$ref": "#/$defs/rollback"}}}},
    {"if": {"properties": {"operation": {"const": "CLOSE"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/close"}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reference": {"type": "string", "minLength": 1, "maxLength": 2048},
    "reason": {"type": "object", "additionalProperties": false, "required": ["reason_code"], "properties": {"reason_code": {"type": "string", "minLength": 1, "maxLength": 128}}},
    "detect": {"type": "object", "additionalProperties": false, "required": ["incident_id", "detection_id", "severity", "owner", "scope", "safe_summary", "evidence_refs", "auto_contain"], "properties": {"incident_id": {"type": "string", "format": "uuid"}, "detection_id": {"type": "string", "minLength": 1, "maxLength": 256}, "severity": {"enum": ["P0", "P1", "P2", "P3"]}, "owner": {"type": "string", "minLength": 1, "maxLength": 256}, "scope": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}}, "safe_summary": {"type": "string", "minLength": 1, "maxLength": 512}, "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}}, "auto_contain": {"const": true}}},
    "triage": {"type": "object", "additionalProperties": false, "required": ["owner", "severity", "reason_code"], "properties": {"owner": {"type": "string", "minLength": 1, "maxLength": 256}, "severity": {"enum": ["P0", "P1", "P2", "P3"]}, "reason_code": {"type": "string", "minLength": 1, "maxLength": 128}}},
    "contain": {"type": "object", "additionalProperties": false, "required": ["reason_code", "targets", "break_glass"], "properties": {"reason_code": {"type": "string", "minLength": 1, "maxLength": 128}, "targets": {"type": "object", "additionalProperties": false, "required": ["kill_task", "revoke_credentials", "isolate_integrations", "freeze_artifacts"], "properties": {"kill_task": {"const": true}, "revoke_credentials": {"const": true}, "isolate_integrations": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}}, "freeze_artifacts": {"const": true}}}, "break_glass": {"type": ["object", "null"]}}},
    "preserve": {"type": "object", "additionalProperties": false, "required": ["chain_head_digest", "snapshot_digest", "process_digest", "network_digest", "configuration_digest", "version_digest", "legal_hold_id"], "properties": {"chain_head_digest": {"$ref": "#/$defs/digest"}, "snapshot_digest": {"$ref": "#/$defs/digest"}, "process_digest": {"$ref": "#/$defs/digest"}, "network_digest": {"$ref": "#/$defs/digest"}, "configuration_digest": {"$ref": "#/$defs/digest"}, "version_digest": {"$ref": "#/$defs/digest"}, "legal_hold_id": {"type": "string", "minLength": 1, "maxLength": 256}}},
    "replayPlan": {"type": "object", "additionalProperties": false, "required": ["replay_id", "mode", "input_digest", "source_snapshot_digest", "expected_result_digest", "resource_refs", "credential_profile", "fresh_lease_id", "fresh_lease_digest", "authorization_lease_expires_at"], "properties": {"replay_id": {"type": "string", "format": "uuid"}, "mode": {"enum": ["LOGICAL", "SANDBOX", "LIVE"]}, "input_digest": {"$ref": "#/$defs/digest"}, "source_snapshot_digest": {"$ref": "#/$defs/digest"}, "expected_result_digest": {"$ref": "#/$defs/digest"}, "resource_refs": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}}, "credential_profile": {"type": ["string", "null"]}, "fresh_lease_id": {"type": ["string", "null"], "format": "uuid"}, "fresh_lease_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "authorization_lease_expires_at": {"type": ["string", "null"], "format": "date-time"}}},
    "replayRun": {"type": "object", "additionalProperties": false, "required": ["replay_id", "mode", "plan_digest"], "properties": {"replay_id": {"type": "string", "format": "uuid"}, "mode": {"enum": ["LOGICAL", "SANDBOX", "LIVE"]}, "plan_digest": {"$ref": "#/$defs/digest"}}},
    "rootCause": {"type": "object", "additionalProperties": false, "required": ["report_id", "report_digest", "findings", "remediations"], "properties": {"report_id": {"type": "string", "format": "uuid"}, "report_digest": {"$ref": "#/$defs/digest"}, "findings": {"type": "array", "minItems": 1, "maxItems": 256}, "remediations": {"type": "array", "minItems": 1, "maxItems": 512}}},
    "recertification": {"type": "object", "additionalProperties": false, "required": ["root_cause_digest", "release_digest", "campaigns"], "properties": {"root_cause_digest": {"$ref": "#/$defs/digest"}, "release_digest": {"$ref": "#/$defs/digest"}, "campaigns": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string"}}}},
    "releaseGate": {"type": "object", "additionalProperties": false, "required": ["release_digest", "definition", "evidence", "rollback_artifact_digest", "canary_plan_digest", "valid_until"], "properties": {"release_digest": {"$ref": "#/$defs/digest"}, "definition": {"type": "object"}, "evidence": {"type": "array", "minItems": 10, "maxItems": 128}, "rollback_artifact_digest": {"$ref": "#/$defs/digest"}, "canary_plan_digest": {"$ref": "#/$defs/digest"}, "valid_until": {"type": "string", "format": "date-time"}}},
    "startCanary": {"type": "object", "additionalProperties": false, "required": ["certificate_id", "release_digest", "canary_plan_digest", "percentage"], "properties": {"certificate_id": {"type": "string", "format": "uuid"}, "release_digest": {"$ref": "#/$defs/digest"}, "canary_plan_digest": {"$ref": "#/$defs/digest"}, "percentage": {"type": "integer", "minimum": 1, "maximum": 10}}},
    "recordCanary": {"type": "object", "additionalProperties": false, "required": ["certificate_id", "release_digest", "metrics_digest", "passed", "rollback_required"], "properties": {"certificate_id": {"type": "string", "format": "uuid"}, "release_digest": {"$ref": "#/$defs/digest"}, "metrics_digest": {"$ref": "#/$defs/digest"}, "passed": {"type": "boolean"}, "rollback_required": {"type": "boolean"}}},
    "rollback": {"type": "object", "additionalProperties": false, "required": ["release_digest", "target_release_digest", "reason_digest"], "properties": {"release_digest": {"$ref": "#/$defs/digest"}, "target_release_digest": {"$ref": "#/$defs/digest"}, "reason_digest": {"$ref": "#/$defs/digest"}}},
    "close": {"type": "object", "additionalProperties": false, "required": ["root_cause_digest", "recertification_evidence_ref", "recertification_evidence_digest"], "properties": {"root_cause_digest": {"$ref": "#/$defs/digest"}, "recertification_evidence_ref": {"$ref": "#/$defs/reference"}, "recertification_evidence_digest": {"$ref": "#/$defs/digest"}}}
  }
}
