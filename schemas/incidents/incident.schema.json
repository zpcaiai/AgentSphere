{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/incidents/incident.schema.json",
  "title": "Incident Record",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "incident_id", "correlation_key", "severity", "status", "safe_summary", "evidence_refs", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "agenttrust.incident.v1"}, "tenant_id": {"type": "string", "minLength": 1},
    "incident_id": {"type": "string", "minLength": 1}, "correlation_key": {"type": "string", "minLength": 1},
    "severity": {"enum": ["P0", "P1", "P2", "P3"]},
    "status": {"enum": ["OPEN", "CONTAINED", "INVESTIGATING", "REMEDIATED", "CLOSED"]},
    "safe_summary": {"type": "string", "minLength": 1, "maxLength": 4096},
    "evidence_refs": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}
  }
}
