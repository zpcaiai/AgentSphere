{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/incidents/incident-mutation-result.schema.json",
  "title": "Durable incident authority mutation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_id", "resource_id", "operation", "resource_version", "state", "result_digest", "evidence_outbox_ref", "effect_receipt", "release_receipt"],
  "properties": {
    "schema_version": {"const": "agenttrust.incident-mutation-result.v1"},
    "command_id": {"type": "string", "format": "uuid"},
    "resource_id": {"type": "string", "minLength": 1, "maxLength": 1024},
    "operation": {"enum": ["DETECT", "TRIAGE", "CONTAIN", "INVESTIGATE", "PRESERVE_EVIDENCE", "PLAN_REPLAY", "COMPLETE_REPLAY", "PUBLISH_ROOT_CAUSE", "BEGIN_REMEDIATION", "TRIGGER_RECERTIFICATION", "EVALUATE_RELEASE", "START_CANARY", "RECORD_CANARY", "ROLLBACK_RELEASE", "CLOSE"]},
    "resource_version": {"type": "integer", "minimum": 1},
    "state": {"enum": ["DETECTED", "TRIAGED", "CONTAINED", "INVESTIGATING", "REMEDIATING", "RECERTIFYING", "CLOSED", "GATE_PASSED", "CANARY_RUNNING", "CANARY_PASSED", "ROLLBACK_REQUIRED", "ROLLED_BACK"]},
    "result_digest": {"$ref": "#/$defs/digest"},
    "evidence_outbox_ref": {"type": "string", "pattern": "^outbox://incident-evidence/", "maxLength": 2048},
    "effect_receipt": {"anyOf": [{"$ref": "#/$defs/effectReceipt"}, {"type": "null"}]},
    "release_receipt": {"anyOf": [{"$ref": "../release/release-gate-engine-receipt.schema.json"}, {"type": "null"}]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "effectReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation", "resource_id", "idempotency_key", "action_hash", "ledger_execution_id", "fence_digest", "policy_decision_digest", "authorization_evidence_ref", "authorization_evidence_digest", "effect_count", "production_access_detected", "input_digest", "result_digest", "difference_digest", "evidence_refs", "evidence_digests"],
      "properties": {
        "schema_version": {"enum": ["agenttrust.containment-effect-receipt.v1", "agenttrust.replay-effect-receipt.v1"]},
        "operation": {"enum": ["DETECT", "CONTAIN", "COMPLETE_REPLAY"]},
        "resource_id": {"type": "string", "minLength": 1, "maxLength": 1024},
        "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[A-Za-z0-9._:/-]+$"},
        "action_hash": {"$ref": "#/$defs/digest"},
        "ledger_execution_id": {"type": "string", "format": "uuid"},
        "fence_digest": {"$ref": "#/$defs/digest"},
        "policy_decision_digest": {"$ref": "#/$defs/digest"},
        "authorization_evidence_ref": {"type": "string", "minLength": 12, "maxLength": 2048},
        "authorization_evidence_digest": {"$ref": "#/$defs/digest"},
        "effect_count": {"type": "integer", "minimum": 0},
        "production_access_detected": {"type": "boolean"},
        "input_digest": {"$ref": "#/$defs/digest"},
        "result_digest": {"$ref": "#/$defs/digest"},
        "difference_digest": {"$ref": "#/$defs/digest"},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 12, "maxLength": 2048}},
        "evidence_digests": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}
      }
    }
  }
}
