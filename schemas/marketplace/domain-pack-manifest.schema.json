{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agenttrust.dev/marketplace/domain-pack-manifest.schema.json",
  "title": "Marketplace verified Domain Pack manifest wire contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_id", "version", "digest", "publisher_identity", "description", "permissions", "tools", "policy_bundle_ref", "evaluator_ref", "compensation_refs", "threat_scenario_refs", "artifact_refs", "compatibility", "signature"],
  "properties": {
    "schema_version": {"const": "agenttrust.domain-pack.v1"},
    "pack_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,256}$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "digest": {"$ref": "#/$defs/digest"},
    "publisher_identity": {"type": "string", "pattern": "^[A-Za-z0-9._:/@-]{1,256}$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 4096},
    "permissions": {"$ref": "#/$defs/permissions"},
    "tools": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/tool"}},
    "policy_bundle_ref": {"type": "string", "pattern": "^policy:sha256:[a-f0-9]{64}$"},
    "evaluator_ref": {"type": "string", "pattern": "^evaluator:sha256:[a-f0-9]{64}$"},
    "compensation_refs": {"$ref": "#/$defs/stringSet"},
    "threat_scenario_refs": {"allOf": [{"$ref": "#/$defs/stringSet"}, {"minItems": 1}]},
    "artifact_refs": {
      "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!.*:latest$).{1,1980}sha256:[a-f0-9]{64}$"}
    },
    "compatibility": {"allOf": [{"$ref": "#/$defs/stringSet"}, {"minItems": 1}]},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stringSet": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "permissions": {
      "type": "object", "additionalProperties": false,
      "required": ["tools", "network_destinations", "data_classes", "secret_scopes", "executors", "approval_scopes"],
      "properties": {
        "tools": {"$ref": "#/$defs/stringSet"},
        "network_destinations": {"$ref": "#/$defs/stringSet"},
        "data_classes": {"$ref": "#/$defs/stringSet"},
        "secret_scopes": {"$ref": "#/$defs/stringSet"},
        "executors": {"$ref": "#/$defs/stringSet"},
        "approval_scopes": {"$ref": "#/$defs/stringSet"}
      }
    },
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_id", "effect_class", "approval_required", "compensation_ref", "irreversible_reason", "executor_template"],
      "properties": {
        "tool_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "effect_class": {"enum": ["PURE", "IDEMPOTENT", "COMPENSATABLE", "IRREVERSIBLE"]},
        "approval_required": {"type": "boolean"},
        "compensation_ref": {"type": ["string", "null"], "maxLength": 512},
        "irreversible_reason": {"type": ["string", "null"], "maxLength": 2048},
        "executor_template": {"type": "string", "minLength": 1, "maxLength": 256, "not": {"pattern": "(/bin/sh|bash -c)"}}
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["key_id", "publisher_identity", "subject_digest", "signature", "signed_at"],
      "properties": {
        "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "publisher_identity": {"type": "string", "minLength": 1, "maxLength": 256},
        "subject_digest": {"$ref": "#/$defs/digest"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"},
        "signed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
