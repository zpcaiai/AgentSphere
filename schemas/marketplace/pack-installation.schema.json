{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agenttrust.dev/marketplace/pack-installation.schema.json",
  "title": "Authoritative tenant Pack installation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "installation_id", "release_id", "pack_id", "version", "pack_digest", "environment", "requester_subject", "request_reason_digest", "permission_digest", "permission_diff", "permission_expansion", "state", "approved_by", "approval_digest", "artifact_receipt_digest", "previous_installation_id", "production_certificate_digest", "updated_at"],
  "properties": {
    "schema_version": {"const": "agenttrust.pack-installation.v1"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "installation_id": {"type": "string", "format": "uuid"},
    "release_id": {"type": "string", "format": "uuid"},
    "pack_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "pack_digest": {"$ref": "#/$defs/digest"},
    "environment": {"enum": ["development", "staging", "canary", "production"]},
    "requester_subject": {"type": "string", "minLength": 1, "maxLength": 256},
    "request_reason_digest": {"$ref": "#/$defs/digest"},
    "permission_digest": {"$ref": "#/$defs/digest"},
    "permission_diff": {"$ref": "#/$defs/permissionDiff"},
    "permission_expansion": {"type": "boolean"},
    "state": {"enum": ["PENDING_APPROVAL", "APPROVED", "REJECTED", "INSTALLED", "ACTIVE", "INACTIVE", "ROLLED_BACK", "REVOKED"]},
    "approved_by": {"type": ["string", "null"], "maxLength": 256},
    "approval_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "artifact_receipt_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "previous_installation_id": {"type": ["string", "null"], "format": "uuid"},
    "production_certificate_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stringSet": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "permissionDiff": {
      "type": "object", "additionalProperties": false,
      "required": ["added_tools", "added_network_destinations", "added_data_classes", "added_secret_scopes", "added_executors", "added_approval_scopes"],
      "properties": {
        "added_tools": {"$ref": "#/$defs/stringSet"},
        "added_network_destinations": {"$ref": "#/$defs/stringSet"},
        "added_data_classes": {"$ref": "#/$defs/stringSet"},
        "added_secret_scopes": {"$ref": "#/$defs/stringSet"},
        "added_executors": {"$ref": "#/$defs/stringSet"},
        "added_approval_scopes": {"$ref": "#/$defs/stringSet"}
      }
    }
  }
}
