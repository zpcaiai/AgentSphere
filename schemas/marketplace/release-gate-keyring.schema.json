{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agenttrust.dev/marketplace/release-gate-keyring.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "required_gate_id", "keys"],
  "properties": {
    "schema_version": {"const": "agenttrust.pack-release-gate-keyring.v1"},
    "required_gate_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,128}$"},
    "keys": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key_id", "algorithm", "usage", "status", "public_key", "not_before", "expires_at"],
        "properties": {
          "key_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,128}$"},
          "algorithm": {"const": "Ed25519"},
          "usage": {"const": "RELEASE_GATE_CERTIFICATE"},
          "status": {"enum": ["ACTIVE", "VERIFY_ONLY"]},
          "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
          "not_before": {"type": "string", "format": "date-time"},
          "expires_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
