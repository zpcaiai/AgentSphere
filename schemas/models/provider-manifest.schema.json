{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/provider-manifest.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "provider_id", "model_id", "model_version", "region", "jurisdiction", "deployment", "capabilities", "endpoint_digest", "data_terms_version", "approved_tenants", "approved", "revoked", "maximum_context_bytes", "maximum_output_bytes", "cost_microunits_per_token"],
  "properties": {
    "schema_version": {"const": "agenttrust.model.v1"}, "provider_id": {"type": "string", "minLength": 1}, "model_id": {"type": "string", "minLength": 1}, "model_version": {"type": "string", "minLength": 1},
    "region": {"type": "string"}, "jurisdiction": {"type": "string", "minLength": 1}, "deployment": {"enum": ["PUBLIC_API", "VPC", "ON_PREM", "LOCAL"]},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["GENERATE", "STREAM", "EMBEDDINGS", "TOOL_CALLING", "STRUCTURED_OUTPUT"]}},
    "endpoint_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "data_terms_version": {"type": "string", "minLength": 1},
    "approved_tenants": {"type": "array", "items": {"type": "string"}}, "approved": {"type": "boolean"}, "revoked": {"type": "boolean"},
    "maximum_context_bytes": {"type": "integer", "minimum": 1}, "maximum_output_bytes": {"type": "integer", "minimum": 1}, "cost_microunits_per_token": {"type": "integer", "minimum": 0}
  }
}
