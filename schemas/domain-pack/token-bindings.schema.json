{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/domain-pack/token-bindings.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "bindings"],
  "properties": {
    "schema_version": {"const": "agenttrust.supply-chain-token-bindings.v1"},
    "bindings": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "object", "additionalProperties": false, "required": ["client_identity", "tenant_id", "subject", "scope", "token_sha256"], "properties": {
      "client_identity": {"type": "string", "pattern": "^(DNS|URI):.+$"}, "tenant_id": {"type": "string", "format": "uuid"},
      "subject": {"type": "string", "minLength": 1, "maxLength": 512}, "scope": {"enum": ["supply-chain:publish", "supply-chain:approve", "supply-chain:activate", "supply-chain:revoke", "supply-chain:read", "supply-chain:recover"]},
      "token_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }} }
  }
}
