{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/domain-pack/domain-pack.schema.json",
  "title": "Domain Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "version", "publisher", "minimum_control_plane_version", "permissions", "network_destinations", "data_classes", "tools", "production_activation", "arbitrary_code_execution"],
  "properties": {
    "schema_version": {"const": "agenttrust.domain-pack.v1"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "publisher": {"type": "string", "minLength": 1},
    "minimum_control_plane_version": {"type": "string", "minLength": 1},
    "permissions": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string"}},
    "network_destinations": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string"}},
    "data_classes": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string"}},
    "tools": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/tool"}},
    "production_activation": {"$ref": "#/$defs/activation"},
    "arbitrary_code_execution": {"const": false}
  },
  "$defs": {
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "effect_class", "input_schema_digest", "timeout_seconds"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "effect_class": {"enum": ["READ", "WRITE_REVERSIBLE", "WRITE_IRREVERSIBLE", "PHYSICAL"]},
        "input_schema_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "compensation": {"type": ["string", "null"]}
      }
    },
    "activation": {
      "type": "object", "additionalProperties": false,
      "required": ["requires_signature", "requires_sbom", "requires_approval", "requires_release_certificate"],
      "properties": {
        "requires_signature": {"const": true}, "requires_sbom": {"const": true},
        "requires_approval": {"const": true}, "requires_release_certificate": {"const": true}
      }
    }
  }
}
