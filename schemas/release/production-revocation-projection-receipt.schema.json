{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/release/production-revocation-projection-receipt.schema.json",
  "title": "Signed revocation projection and complete watcher acknowledgement receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_digest", "projection_id", "projection_head",
    "watcher_acks", "committed", "completed_at", "projection_key_id", "signature"
  ],
  "properties": {
    "schema_version": {"const": "agenttrust.production-revocation-projection-receipt.v1"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "projection_id": {"$ref": "#/$defs/identifier"},
    "projection_head": {"$ref": "production-revocation-projection-head.schema.json"},
    "watcher_acks": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "schema_version", "projection_id", "watcher_id", "registry_sequence",
          "registry_digest", "activation_receipt_digest", "acknowledged_at"
        ],
        "properties": {
          "schema_version": {"const": "agenttrust.production-revocation-watcher-ack.v1"},
          "projection_id": {"$ref": "#/$defs/identifier"},
          "watcher_id": {"$ref": "#/$defs/identifier"},
          "registry_sequence": {"type": "integer", "minimum": 1},
          "registry_digest": {"$ref": "#/$defs/digest"},
          "activation_receipt_digest": {"$ref": "#/$defs/digest"},
          "acknowledged_at": {"type": "string", "format": "date-time", "maxLength": 64}
        }
      }
    },
    "committed": {"const": true},
    "completed_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "projection_key_id": {"$ref": "#/$defs/identifier"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}
  }
}
