{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/release/deployment-cutover-broker-response.schema.json",
  "title": "Externally executed deployment cutover response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_id", "request_digest", "source_release_id",
    "target_release_id", "environment_reference", "operation",
    "expected_previous_transition_digest", "writer_fence_receipt_digest",
    "inventory", "signed_receipt", "completed_at"
  ],
  "properties": {
    "schema_version": {"const": "agenttrust.deployment-cutover-broker-response.v1"},
    "request_id": {"type": "string", "pattern": "^deployment-cutover-[0-9a-f]{32}$"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "source_release_id": {"$ref": "#/$defs/releaseId"},
    "target_release_id": {"$ref": "#/$defs/releaseId"},
    "environment_reference": {"$ref": "#/$defs/environment"},
    "operation": {"enum": ["WRITER_FENCE", "CUTOVER", "ROLLBACK", "UNFREEZE"]},
    "expected_previous_transition_digest": {"$ref": "#/$defs/digest"},
    "writer_fence_receipt_digest": {"$ref": "#/$defs/digest"},
    "inventory": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "deployment-blue-green-inventory.schema.json"}
      ]
    },
    "signed_receipt": {"$ref": "signed-deployment-control-receipt.schema.json"},
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "releaseId": {"type": "string", "pattern": "^git:(?:sha1:[0-9a-f]{40}|sha256:[0-9a-f]{64})$"},
    "environment": {"type": "string", "pattern": "^environment://production/[A-Za-z0-9][A-Za-z0-9._:/-]{0,447}$"}
  }
}
