{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/release/production-release-activation.schema.json",
  "title": "Production release activation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "release_id", "scope", "images", "production_image_manifest",
    "signed_release_binding_digest", "evidence_bundle_manifest_digest", "requested_at"
  ],
  "properties": {
    "schema_version": {"const": "agenttrust.production-release-activation.v1"},
    "release_id": {"$ref": "#/$defs/releaseId"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id", "commit_digest", "build_digest", "signed_git_provenance_digest",
        "signed_release_binding_digest", "release_digest", "reviewer_keyring_digest", "policy_digest",
        "pack_set_digest", "prompt_set_digest", "model_set_digest",
        "topology_digest", "environment", "valid_from", "valid_until"
      ],
      "properties": {
        "release_id": {"$ref": "#/$defs/releaseId"},
        "commit_digest": {"$ref": "#/$defs/digest"},
        "build_digest": {"$ref": "#/$defs/digest"},
        "signed_git_provenance_digest": {"$ref": "#/$defs/digest"},
        "signed_release_binding_digest": {"$ref": "#/$defs/digest"},
        "release_digest": {"$ref": "#/$defs/digest"},
        "reviewer_keyring_digest": {"$ref": "#/$defs/digest"},
        "policy_digest": {"$ref": "#/$defs/digest"},
        "pack_set_digest": {"$ref": "#/$defs/digest"},
        "prompt_set_digest": {"$ref": "#/$defs/digest"},
        "model_set_digest": {"$ref": "#/$defs/digest"},
        "topology_digest": {"$ref": "#/$defs/digest"},
        "environment": {"const": "production"},
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"}
      }
    },
    "images": {
      "type": "object",
      "minProperties": 31,
      "maxProperties": 31,
      "propertyNames": {"$ref": "#/$defs/imageName"},
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:/-]*@sha256:[a-f0-9]{64}$"
      }
    },
    "production_image_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "release_id", "release_tag", "repository", "created_at", "images", "attestations", "manifest_digest"],
      "properties": {
        "schema_version": {"const": "agenttrust.production-image-manifest.v1"},
        "release_id": {"$ref": "#/$defs/releaseId"},
        "release_tag": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"},
        "created_at": {"type": "string", "format": "date-time"},
        "images": {"$ref": "#/$defs/images"},
        "attestations": {
          "type": "object",
          "minProperties": 31,
          "maxProperties": 31,
          "propertyNames": {"$ref": "#/$defs/imageName"},
          "additionalProperties": {"$ref": "#/$defs/imageAttestation"}
        },
        "manifest_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "signed_release_binding_digest": {"$ref": "#/$defs/digest"},
    "evidence_bundle_manifest_digest": {"$ref": "#/$defs/digest"},
    "requested_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "images": {
      "type": "object",
      "minProperties": 31,
      "maxProperties": 31,
      "propertyNames": {"$ref": "#/$defs/imageName"},
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:/-]*@sha256:[a-f0-9]{64}$"
      }
    },
    "imageName": {
      "enum": ["runtime", "orchestrator", "transition", "execution", "registry", "agent_registry", "policy_admin", "incident_release", "pack_marketplace", "approval", "pep", "identity", "tool_proxy", "evidence", "audit", "enterprise", "enterprise_authority", "model_gateway", "data_governance", "context_governance", "runtime_anomaly", "security_evaluation", "pack_supply_chain", "domain_runtime", "platform_sre", "console", "migration", "envoy", "utility", "release_admission", "sandbox_worker"]
    },
    "imageAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "subject_digest", "sbom_sha256", "provenance_attestation_url", "sbom_attestation_url"],
      "properties": {
        "component": {"type": "string", "minLength": 1, "maxLength": 128},
        "subject_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "sbom_sha256": {"$ref": "#/$defs/digest"},
        "provenance_attestation_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "sbom_attestation_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "releaseId": {
      "type": "string",
      "pattern": "^git:(?:sha1:[a-f0-9]{40}|sha256:[a-f0-9]{64})$"
    }
  }
}
