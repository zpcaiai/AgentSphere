{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/release/production-qualification-input.schema.json",
  "title": "Untrusted production qualification material",
  "description": "Trust keyrings are separate deployment inputs. Batch status and GateEvidence are intentionally not accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "environment_reference", "scope", "git_provenance",
    "release_binding", "batch_records", "condition_records", "worm_receipts",
    "external_assurances", "domain_assurances", "residual_risks", "exceptions"
  ],
  "properties": {
    "schema_version": {"const": "agenttrust.production-qualification-input.v1"},
    "environment_reference": {
      "type": "string", "pattern": "^environment://production/.+$", "maxLength": 512
    },
    "scope": {"$ref": "#/$defs/scope"},
    "git_provenance": {"$ref": "signed-git-provenance.schema.json"},
    "release_binding": {"$ref": "signed-release-binding.schema.json"},
    "batch_records": {
      "type": "array", "minItems": 35, "maxItems": 35,
      "items": {"$ref": "qualified-evidence-record.schema.json"}
    },
    "condition_records": {
      "type": "array", "minItems": 17, "maxItems": 17,
      "items": {"$ref": "qualified-evidence-record.schema.json"}
    },
    "worm_receipts": {
      "type": "array", "minItems": 52, "maxItems": 52,
      "items": {"$ref": "signed-worm-evidence-receipt.schema.json"}
    },
    "external_assurances": {
      "type": "array", "minItems": 11, "maxItems": 11,
      "items": {"$ref": "external-gate-assurance-attestation.schema.json"}
    },
    "domain_assurances": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"$ref": "domain-assurance-attestation.schema.json"}
    },
    "residual_risks": {
      "type": "array", "maxItems": 10000,
      "items": {"$ref": "#/$defs/risk"}
    },
    "exceptions": {
      "type": "array", "maxItems": 1000,
      "items": {"$ref": "#/$defs/exception"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": [
        "release_id", "commit_digest", "signed_git_provenance_digest",
        "signed_release_binding_digest", "release_digest", "reviewer_keyring_digest",
        "build_digest", "policy_digest",
        "pack_set_digest", "prompt_set_digest", "model_set_digest",
        "topology_digest", "environment", "valid_from", "valid_until"
      ],
      "properties": {
        "release_id": {"type": "string", "pattern": "^git:(?:sha1:[0-9a-f]{40}|sha256:[0-9a-f]{64})$"},
        "commit_digest": {"$ref": "#/$defs/digest"},
        "signed_git_provenance_digest": {"$ref": "#/$defs/digest"},
        "signed_release_binding_digest": {"$ref": "#/$defs/digest"},
        "release_digest": {"$ref": "#/$defs/digest"},
        "reviewer_keyring_digest": {"$ref": "#/$defs/digest"},
        "build_digest": {"$ref": "#/$defs/digest"},
        "policy_digest": {"$ref": "#/$defs/digest"},
        "pack_set_digest": {"$ref": "#/$defs/digest"},
        "prompt_set_digest": {"$ref": "#/$defs/digest"},
        "model_set_digest": {"$ref": "#/$defs/digest"},
        "topology_digest": {"$ref": "#/$defs/digest"},
        "environment": {"const": "production"},
        "valid_from": {"type": "string", "format": "date-time", "maxLength": 64},
        "valid_until": {"type": "string", "format": "date-time", "maxLength": 64}
      }
    },
    "risk": {
      "type": "object", "additionalProperties": false,
      "required": ["risk_id", "severity", "description", "owner", "acceptance"],
      "properties": {
        "risk_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "severity": {"enum": ["P2", "P3"]},
        "description": {"type": "string", "minLength": 1, "maxLength": 4096},
        "owner": {"type": "string", "minLength": 1, "maxLength": 256},
        "acceptance": {"$ref": "signed-risk-acceptance.schema.json"}
      }
    },
    "exception": {
      "type": "object", "additionalProperties": false,
      "required": [
        "exception_id", "gate_id", "severity", "owner", "approval",
        "compensating_control_digests", "expires_at"
      ],
      "properties": {
        "exception_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "gate_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "severity": {"enum": ["P2", "P3"]},
        "owner": {"type": "string", "minLength": 1, "maxLength": 256},
        "approval": {"$ref": "signed-exception-approval.schema.json"},
        "compensating_control_digests": {
          "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
          "items": {"$ref": "#/$defs/digest"}
        },
        "expires_at": {"type": "string", "format": "date-time", "maxLength": 64}
      }
    }
  }
}
