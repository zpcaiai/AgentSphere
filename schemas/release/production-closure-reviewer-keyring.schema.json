{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/release/production-closure-reviewer-keyring.schema.json",
  "title": "Production Closure Trusted Reviewer Keyring",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "keyring_id", "version", "issued_at", "expires_at", "keys"],
  "properties": {
    "schema_version": {"const": "agenttrust.production-closure-reviewer-keyring.v1"},
    "keyring_id": {"$ref": "#/$defs/identifier"},
    "version": {"type": "integer", "minimum": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "keys": {
      "type": "array",
      "minItems": 2,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/key"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "role": {
      "enum": [
        "SAFETY_ENGINEER", "OPERATIONS_OWNER", "LICENSED_CLINICIAN",
        "PRIVACY_LEGAL_REVIEWER", "SAFEGUARDING_LEAD", "HUMAN_SUPPORT_OWNER",
        "RELEASE_ENGINEER", "INDEPENDENT_AUDITOR", "SECURITY_ENGINEER", "SRE",
        "CODING_DOMAIN_OWNER", "ENERGY_DOMAIN_ENGINEER", "RED_TEAM_LEAD",
        "SECURITY_OWNER", "DISASTER_RECOVERY_OWNER", "COMPLIANCE_OWNER",
        "CUSTOMER_RELEASE_AUTHORITY"
      ]
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id", "reviewer_id", "organization", "roles", "key_usage", "algorithm",
        "public_key", "status", "not_before", "not_after", "revoked_at"
      ],
      "properties": {
        "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
        "reviewer_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "organization": {"type": "string", "minLength": 1, "maxLength": 256},
        "roles": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": {"$ref": "#/$defs/role"}
        },
        "key_usage": {"const": "PRODUCTION_ASSURANCE_REVIEW"},
        "algorithm": {"const": "Ed25519"},
        "public_key": {"type": "string", "minLength": 43, "maxLength": 43, "pattern": "^[A-Za-z0-9_-]+$"},
        "status": {"enum": ["ACTIVE", "REVOKED"]},
        "not_before": {"type": "string", "format": "date-time"},
        "not_after": {"type": "string", "format": "date-time"},
        "revoked_at": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "format": "date-time"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "ACTIVE"}}},
          "then": {"properties": {"revoked_at": {"type": "null"}}}
        },
        {
          "if": {"properties": {"status": {"const": "REVOKED"}}},
          "then": {"properties": {"revoked_at": {"type": "string", "format": "date-time"}}}
        }
      ]
    }
  }
}
