{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/release/worm-evidence-keyring.schema.json",
  "title": "Deployment-owned WORM evidence receipt trust anchors",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "keys"],
  "properties": {
    "schema_version": {"const": "agenttrust.worm-evidence-keyring.v1"},
    "keys": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "issuer", "key_id", "key_usage", "algorithm", "public_key", "status",
          "not_before", "not_after"
        ],
        "properties": {
          "issuer": {
            "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,255}$"
          },
          "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "key_usage": {"const": "PRODUCTION_EVIDENCE_WORM_RECEIPT"},
          "algorithm": {"const": "Ed25519"},
          "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
          "status": {"enum": ["ACTIVE", "REVOKED"]},
          "not_before": {"type": "string", "format": "date-time", "maxLength": 64},
          "not_after": {"type": "string", "format": "date-time", "maxLength": 64}
        }
      }
    }
  }
}
