{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agenttrust.dev/release/production-revocation-checkpoint-cas-receipt.schema.json",
  "title": "Production revocation checkpoint CAS receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "previous_sequence", "sequence", "previous_checkpoint_digest", "checkpoint_digest", "registry_digest", "advanced_at", "receipt_digest"],
  "properties": {
    "schema_version": {"const": "agenttrust.production-revocation-checkpoint-cas.v1"},
    "registry_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "previous_sequence": {"type": "integer", "minimum": 0},
    "sequence": {"type": "integer", "minimum": 1},
    "previous_checkpoint_digest": {"$ref": "#/$defs/digest"},
    "checkpoint_digest": {"$ref": "#/$defs/digest"},
    "registry_digest": {"$ref": "#/$defs/digest"},
    "advanced_at": {"type": "string", "format": "date-time"},
    "receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
