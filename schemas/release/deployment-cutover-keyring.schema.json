{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/release/deployment-cutover-keyring.schema.json",
  "title": "Production deployment cutover signer keyring",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "keyring_id", "version", "issued_at", "expires_at", "keys"],
  "properties": {
    "schema_version": {"const": "agenttrust.deployment-cutover-keyring.v1"},
    "keyring_id": {"$ref": "#/$defs/identifier"},
    "version": {"type": "integer", "minimum": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "keys": {
      "type": "array", "minItems": 4, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "key_id", "signer_id", "organization", "roles", "key_usage", "algorithm",
          "public_key", "status", "not_before", "not_after", "revoked_at"
        ],
        "properties": {
          "key_id": {"$ref": "#/$defs/identifier"},
          "signer_id": {"$ref": "#/$defs/identifier"},
          "organization": {"type": "string", "minLength": 1, "maxLength": 256},
          "roles": {
            "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
            "items": {"enum": [
              "SRE_RELEASE_FENCE", "RELEASE_CUTOVER_AUTHORITY",
              "DISASTER_RECOVERY_OWNER", "SRE_RELEASE_UNFREEZE"
            ]}
          },
          "key_usage": {"const": "PRODUCTION_DEPLOYMENT_CUTOVER"},
          "algorithm": {"const": "Ed25519"},
          "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
          "status": {"enum": ["ACTIVE", "REVOKED"]},
          "not_before": {"type": "string", "format": "date-time"},
          "not_after": {"type": "string", "format": "date-time"},
          "revoked_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}
  }
}
