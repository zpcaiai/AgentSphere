{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/release/production-closure-external-signature.schema.json",
  "title": "Production Closure External Signature",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_digest", "algorithm", "key_id", "signed_at", "audit_receipt_digest", "signature"],
  "properties": {
    "schema_version": {"const": "agenttrust.production-closure-external-signature.v2"},
    "request_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "algorithm": {"const": "Ed25519"},
    "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "signed_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "audit_receipt_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signature": {"type": "string", "minLength": 86, "maxLength": 86, "pattern": "^[A-Za-z0-9_-]+$"}
  }
}
