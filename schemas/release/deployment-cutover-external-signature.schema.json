{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/release/deployment-cutover-external-signature.schema.json",
  "title": "External deployment control signature",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_digest", "key_id", "algorithm", "signed_at", "signature"],
  "properties": {
    "schema_version": {"const": "agenttrust.deployment-cutover-external-signature.v1"},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "algorithm": {"const": "Ed25519"},
    "signed_at": {"type": "string", "format": "date-time"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  }
}
