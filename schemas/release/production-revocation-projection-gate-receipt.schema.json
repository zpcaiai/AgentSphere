{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/release/production-revocation-projection-gate-receipt.schema.json",
  "title": "Production revocation projection cluster gate receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "projection_id", "projection_receipt_digest",
    "projection_head_digest", "registry_id", "registry_sequence",
    "registry_digest", "watcher_acknowledgements", "kubernetes_job_uid",
    "kubernetes_pod_uid", "verified", "receipt_digest"
  ],
  "properties": {
    "schema_version": {"const": "agenttrust.production-revocation-projection-gate-receipt.v1"},
    "projection_id": {"$ref": "#/$defs/identifier"},
    "projection_receipt_digest": {"$ref": "#/$defs/digest"},
    "projection_head_digest": {"$ref": "#/$defs/digest"},
    "registry_id": {"$ref": "#/$defs/identifier"},
    "registry_sequence": {"type": "integer", "minimum": 1},
    "registry_digest": {"$ref": "#/$defs/digest"},
    "watcher_acknowledgements": {"type": "integer", "minimum": 1, "maximum": 10000},
    "kubernetes_job_uid": {"type": "string", "format": "uuid"},
    "kubernetes_pod_uid": {"type": "string", "format": "uuid"},
    "verified": {"const": true},
    "receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}
  }
}
