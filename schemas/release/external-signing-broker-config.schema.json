{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/release/external-signing-broker-config.schema.json",
  "title": "External production signing broker client configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "endpoint", "server_name", "oidc_audience", "ca_file", "client_certificate_file", "client_private_key_file", "timeout_seconds", "maximum_response_bytes"],
  "properties": {
    "schema_version": {"const": "agenttrust.external-signing-broker-config.v1"},
    "endpoint": {"type": "string", "format": "uri", "pattern": "^https://[^/?#]+(?::(?:443|8443))?/v1/signatures/ed25519$"},
    "server_name": {"type": "string", "format": "hostname"},
    "oidc_audience": {"type": "string", "minLength": 1, "maxLength": 256},
    "ca_file": {"type": "string", "pattern": "^/"},
    "client_certificate_file": {"type": "string", "pattern": "^/"},
    "client_private_key_file": {"type": "string", "pattern": "^/"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 30},
    "maximum_response_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576}
  }
}
