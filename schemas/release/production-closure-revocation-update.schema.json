{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/release/production-closure-revocation-update.schema.json",
  "title": "Production Closure Revocation Registry Update",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "key_id", "base_checkpoint_digest", "valid_for_seconds", "new_entries"],
  "properties": {
    "schema_version": {"const": "agenttrust.production-closure-revocation-update.v1"},
    "registry_id": {"$ref": "#/$defs/identifier"},
    "key_id": {"$ref": "#/$defs/identifier"},
    "base_checkpoint_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "valid_for_seconds": {"type": "integer", "minimum": 300, "maximum": 604800},
    "new_entries": {
      "type": "array", "maxItems": 10000,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["certificate_id", "release_id", "reason_code", "evidence_digest", "revoked_at"],
      "properties": {
        "certificate_id": {"type": "string", "pattern": "^pc-[a-f0-9]{24}$"},
        "release_id": {"type": "string", "pattern": "^git:(?:sha1:[a-f0-9]{40}|sha256:[a-f0-9]{64})$"},
        "reason_code": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Z0-9_]+$"},
        "evidence_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "revoked_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
