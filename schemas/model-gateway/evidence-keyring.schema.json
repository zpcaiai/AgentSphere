{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agenttrust.invalid/model-gateway/evidence-keyring.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "keys"],
  "properties": {
    "schema_version": {"const": "agenttrust.model-evidence-keyring.v1"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "key_usage", "public_key_base64url", "status"],
        "properties": {
          "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "key_usage": {"const": "AUTHORITY_EVIDENCE_RECEIPT"},
          "public_key_base64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
          "status": {"const": "ACTIVE"}
        }
      }
    }
  }
}
