{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agenttrust.invalid/model-gateway/provider-keyring.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "keys"],
  "properties": {
    "schema_version": {"const": "agenttrust.model-provider-keyring.v1"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "key_usage", "issuer", "provider_ids", "public_key_base64url", "status"],
        "properties": {
          "key_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
          "key_usage": {"enum": ["MODEL_PROVIDER_MANIFEST", "MODEL_PROVIDER_REVOCATION", "MODEL_PROVIDER_RESIDENCY", "MODEL_PROVIDER_BILLING"]},
          "issuer": {"type": "string", "minLength": 1, "maxLength": 256},
          "provider_ids": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
          "public_key_base64url": {"type": "string", "minLength": 43, "maxLength": 43, "pattern": "^[A-Za-z0-9_-]+$"},
          "status": {"const": "ACTIVE"}
        }
      }
    }
  }
}
