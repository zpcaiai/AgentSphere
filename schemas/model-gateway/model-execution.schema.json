{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agenttrust.invalid/model-gateway/model-execution.schema.json",
  "title": "AgentTrust model execution wire contract",
  "$defs": {
    "uuid": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:/-]+$"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "tenant_id", "task_id", "action_id", "canonical_action", "operation", "task_type",
        "classification", "data_label", "source_jurisdiction", "deployment_profile",
        "cross_domain_approval_id", "cross_domain_grant_id", "cross_domain_source_zone",
        "cross_domain_target_zone", "required_capabilities",
        "allowed_provider_ids", "maximum_latency_ms", "maximum_cost_microunits",
        "maximum_output_bytes", "prompt_utf8", "idempotency_key"
      ],
      "properties": {
        "schema_version": {"const": "agenttrust.model-execution-request.v1"},
        "tenant_id": {"$ref": "#/$defs/uuid"},
        "task_id": {"$ref": "#/$defs/uuid"},
        "action_id": {"$ref": "#/$defs/uuid"},
        "canonical_action": {"$ref": "../json/action.schema.json"},
        "operation": {"enum": ["GENERATE", "STREAM", "EMBEDDINGS"]},
        "task_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "classification": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED", "REGULATED"]},
        "data_label": {"$ref": "../data-governance/data-label.schema.json"},
        "source_jurisdiction": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "deployment_profile": {"type": "string", "minLength": 1, "maxLength": 128},
        "cross_domain_approval_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
        "cross_domain_grant_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
        "cross_domain_source_zone": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\s]+$"}, {"type": "null"}]},
        "cross_domain_target_zone": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\s]+$"}, {"type": "null"}]},
        "required_capabilities": {
          "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
          "items": {"enum": ["GENERATE", "STREAM", "EMBEDDINGS", "TOOL_CALLING", "STRUCTURED_OUTPUT"]}
        },
        "allowed_provider_ids": {
          "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"}
        },
        "maximum_latency_ms": {"type": "integer", "minimum": 1, "maximum": 300000},
        "maximum_cost_microunits": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "maximum_output_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "prompt_utf8": {"type": "string", "minLength": 1, "maxLength": 4194304},
        "idempotency_key": {"$ref": "#/$defs/idempotencyKey"}
      },
      "allOf": [
        {
          "if": {"properties": {"cross_domain_grant_id": {"type": "null"}}, "required": ["cross_domain_grant_id"]},
          "then": {"properties": {"cross_domain_approval_id": {"type": "null"}, "cross_domain_source_zone": {"type": "null"}, "cross_domain_target_zone": {"type": "null"}}},
          "else": {"properties": {"cross_domain_approval_id": {"$ref": "#/$defs/uuid"}, "cross_domain_source_zone": {"type": "string"}, "cross_domain_target_zone": {"type": "string"}}}
        }
      ]
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "cost_microunits"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cost_microunits": {"type": "integer", "minimum": 0}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "request_id", "status", "replayed", "output_utf8", "embedding", "artifact_ref",
        "artifact_digest", "untrusted_content", "provider_key", "provider_request_id", "usage",
        "output_digest", "evidence_ref", "evidence_digest"
      ],
      "properties": {
        "schema_version": {"const": "agenttrust.model-execution-result.v1"},
        "request_id": {"$ref": "#/$defs/uuid"},
        "status": {"const": "SUCCEEDED"},
        "replayed": {"type": "boolean"},
        "output_utf8": {"type": ["string", "null"], "maxLength": 1048576},
        "embedding": {"type": ["array", "null"], "maxItems": 65536, "items": {"type": "number"}},
        "artifact_ref": {"type": "string", "pattern": "^artifact://sha256/[a-f0-9]{64}$"},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "untrusted_content": {"const": true},
        "provider_key": {"type": "string", "minLength": 1, "maxLength": 768},
        "provider_request_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "usage": {"$ref": "#/$defs/usage"},
        "output_digest": {"$ref": "#/$defs/digest"},
        "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 512},
        "evidence_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "streamEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "request_id", "sequence", "chunk_utf8", "terminal", "finish_reason", "usage", "artifact_ref", "artifact_digest", "evidence_ref", "evidence_digest"],
      "properties": {
        "schema_version": {"const": "agenttrust.model-stream-event.v1"},
        "request_id": {"$ref": "#/$defs/uuid"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 10000},
        "chunk_utf8": {"type": "string", "maxLength": 1048576},
        "terminal": {"type": "boolean"},
        "finish_reason": {"type": ["string", "null"], "maxLength": 64},
        "usage": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/usage"}]},
        "artifact_ref": {"type": ["string", "null"], "pattern": "^artifact://sha256/[a-f0-9]{64}$"},
        "artifact_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "evidence_ref": {"type": ["string", "null"], "maxLength": 512},
        "evidence_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"terminal": {"const": true}}},
          "then": {"properties": {"finish_reason": {"type": "string"}, "usage": {"$ref": "#/$defs/usage"}, "artifact_ref": {"type": "string", "pattern": "^artifact://sha256/[a-f0-9]{64}$"}, "artifact_digest": {"$ref": "#/$defs/digest"}, "evidence_ref": {"type": "string"}, "evidence_digest": {"$ref": "#/$defs/digest"}}},
          "else": {"properties": {"finish_reason": {"type": "null"}, "usage": {"type": "null"}, "artifact_ref": {"type": "null"}, "artifact_digest": {"type": "null"}, "evidence_ref": {"type": "null"}, "evidence_digest": {"type": "null"}}}
        }
      ]
    }
  }
}
