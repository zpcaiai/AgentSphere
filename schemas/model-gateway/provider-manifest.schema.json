{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agenttrust.invalid/model-gateway/provider-manifest.schema.json",
  "title": "AgentTrust signed model provider manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "provider_id", "model_id", "model_version", "revision",
    "region", "jurisdiction", "deployment", "protocol", "capabilities", "endpoint_profile",
    "endpoint_digest", "data_terms_version", "maximum_context_bytes",
    "maximum_output_bytes", "cost_microunits_per_token", "issuer", "key_id",
    "key_usage", "signature"
  ],
  "properties": {
    "schema_version": {"const": "agenttrust.model-provider-manifest.v1"},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "model_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "model_version": {"type": "string", "minLength": 1, "maxLength": 256},
    "revision": {"type": "integer", "minimum": 1},
    "region": {"type": "string", "minLength": 1, "maxLength": 128},
    "jurisdiction": {"type": "string", "minLength": 1, "maxLength": 128},
    "deployment": {"enum": ["PUBLIC_API", "VPC", "ON_PREM", "LOCAL"]},
    "protocol": {"enum": ["OPENAI_COMPATIBLE", "LOCAL_INFERENCE"]},
    "capabilities": {
      "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
      "items": {"enum": ["GENERATE", "STREAM", "EMBEDDINGS", "TOOL_CALLING", "STRUCTURED_OUTPUT"]}
    },
    "endpoint_profile": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "endpoint_digest": {"$ref": "#/$defs/digest"},
    "data_terms_version": {"type": "string", "minLength": 1, "maxLength": 256},
    "maximum_context_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
    "maximum_output_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
    "cost_microunits_per_token": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "issuer": {"type": "string", "minLength": 1, "maxLength": 256},
    "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "key_usage": {"const": "MODEL_PROVIDER_MANIFEST"},
    "signature": {"type": "string", "minLength": 86, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
