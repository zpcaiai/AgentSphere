{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agenttrust.invalid/model-gateway/token-bindings.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bindings"],
  "properties": {
    "schema_version": {"const": "agenttrust.model-token-bindings.v1"},
    "bindings": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["client_identity", "tenant_id", "scope", "subject", "token_sha256"],
        "properties": {
          "client_identity": {"type": "string", "minLength": 1, "maxLength": 512},
          "tenant_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f-]{36}$"},
          "scope": {"enum": ["models:generate", "models:stream", "models:embeddings", "models:billing:reconcile", "models:executions:read"]},
          "subject": {"type": "string", "minLength": 1, "maxLength": 256},
          "token_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
