{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agenttrust.invalid/model-gateway/provider-revocation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "provider_id", "model_id", "model_version", "provider_revision",
    "provider_manifest_digest", "reason_code", "revoked_at", "issuer", "key_id",
    "key_usage", "signature"
  ],
  "properties": {
    "schema_version": {"const": "agenttrust.model-provider-revocation.v1"},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "model_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "model_version": {"type": "string", "minLength": 1, "maxLength": 256},
    "provider_revision": {"type": "integer", "minimum": 1},
    "provider_manifest_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reason_code": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Z0-9_]+$"},
    "revoked_at": {"type": "string", "format": "date-time"},
    "issuer": {"type": "string", "minLength": 1, "maxLength": 256},
    "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "key_usage": {"const": "MODEL_PROVIDER_REVOCATION"},
    "signature": {"type": "string", "minLength": 86, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$"}
  }
}
