{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/mcp/server-manifest.schema.json",
  "title": "Agent Trust MCP server manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "server_id",
    "version",
    "publisher_id",
    "transport",
    "endpoint",
    "implementation_digest",
    "sbom_digest",
    "permissions",
    "network_endpoints",
    "trust_tier",
    "signer_key_id",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": "agenttrust.mcp.v1"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "server_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._-]+$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "publisher_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "transport": {"enum": ["stdio", "https"]},
    "endpoint": {"type": "string", "minLength": 1, "maxLength": 2048},
    "implementation_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "sbom_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "permissions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"enum": ["TOOLS_LIST", "TOOLS_CALL", "RESOURCES_READ", "NETWORK", "FILESYSTEM_READ", "FILESYSTEM_WRITE"]}
    },
    "network_endpoints": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048}
    },
    "trust_tier": {"const": "untrusted", "description": "Publisher manifests cannot self-assign runtime trust; approval policy resolves the effective tier."},
    "signer_key_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "signature": {"type": "string", "minLength": 86, "maxLength": 86, "pattern": "^[A-Za-z0-9_-]+$"}
  },
  "allOf": [
    {
      "if": {"properties": {"transport": {"const": "stdio"}}},
      "then": {"properties": {"endpoint": {"pattern": "^sha256:[a-f0-9]{64}$"}}}
    },
    {
      "if": {"properties": {"transport": {"const": "https"}}},
      "then": {"properties": {"endpoint": {"pattern": "^https://"}}}
    }
  ]
}
