{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agenttrust.example/platform-sre/sre-external-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "operation", "resource", "idempotency_key", "action_hash", "ledger_execution_id", "ledger_event_id", "ledger_event_digest", "fence_digest", "policy_decision_digest", "authorization_evidence_ref", "authorization_evidence_digest", "request_digest", "result_digest", "immutable_evidence_refs", "immutable_evidence_digests", "external_evidence_status", "production_evidence", "facts"],
  "properties": {
    "schema_version": {"const": "agenttrust.sre-external-receipt.v1"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "operation": {"enum": ["CREATE_BACKUP", "VERIFY_RESTORE", "FAILOVER", "FAILBACK", "EXECUTE_CHAOS", "EXECUTE_LOAD", "ROLLBACK_UPGRADE"]},
    "resource": {"type": "string", "minLength": 1, "maxLength": 2048},
    "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[A-Za-z0-9._:/-]+$"},
    "action_hash": {"$ref": "#/$defs/digest"},
    "ledger_execution_id": {"type": "string", "format": "uuid"},
    "ledger_event_id": {"type": "string", "format": "uuid"},
    "ledger_event_digest": {"$ref": "#/$defs/digest"},
    "fence_digest": {"$ref": "#/$defs/digest"},
    "policy_decision_digest": {"$ref": "#/$defs/digest"},
    "authorization_evidence_ref": {"$ref": "#/$defs/evidenceRef"},
    "authorization_evidence_digest": {"$ref": "#/$defs/digest"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "result_digest": {"$ref": "#/$defs/digest"},
    "immutable_evidence_refs": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}},
    "immutable_evidence_digests": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "external_evidence_status": {"enum": ["NOT_RUN", "OBSERVED", "VERIFIED"]},
    "production_evidence": {"type": "boolean"},
    "facts": {"type": "object", "minProperties": 2, "maxProperties": 32}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidenceRef": {"type": "string", "pattern": "^(evidence://|urn:agenttrust:evidence:)", "maxLength": 2048}
  }
}
