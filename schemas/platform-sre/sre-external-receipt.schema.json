{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agenttrust.example/platform-sre/sre-external-receipt.schema.json",
  "title": "Platform SRE external adapter receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "operation", "resource", "idempotency_key", "action_hash", "ledger_execution_id", "ledger_event_id", "ledger_event_digest", "fence_digest", "policy_decision_digest", "authorization_evidence_ref", "authorization_evidence_digest", "request_digest", "result_digest", "immutable_evidence_refs", "immutable_evidence_digests", "external_evidence_status", "production_evidence", "facts"],
  "properties": {
    "schema_version": {"const": "agenttrust.sre-external-receipt.v1"},
    "tenant_id": {"$ref": "#/$defs/uuid"},
    "operation": {"enum": ["RECORD_ZONE_HEALTH", "CREATE_BACKUP", "VERIFY_RESTORE", "FAILOVER", "FAILBACK", "EXECUTE_CHAOS", "EXECUTE_LOAD", "ROLLBACK_UPGRADE"]},
    "resource": {"$ref": "#/$defs/resourceIdentifier"},
    "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[A-Za-z0-9._:/-]+$"},
    "action_hash": {"$ref": "#/$defs/digest"},
    "ledger_execution_id": {"$ref": "#/$defs/uuid"},
    "ledger_event_id": {"$ref": "#/$defs/uuid"},
    "ledger_event_digest": {"$ref": "#/$defs/digest"},
    "fence_digest": {"$ref": "#/$defs/digest"},
    "policy_decision_digest": {"$ref": "#/$defs/digest"},
    "authorization_evidence_ref": {"$ref": "#/$defs/evidenceRef"},
    "authorization_evidence_digest": {"$ref": "#/$defs/digest"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "result_digest": {"$ref": "#/$defs/digest"},
    "immutable_evidence_refs": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}},
    "immutable_evidence_digests": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "external_evidence_status": {"enum": ["NOT_RUN", "OBSERVED", "VERIFIED"]},
    "production_evidence": {"type": "boolean"},
    "facts": {"type": "object", "maxProperties": 32}
  },
  "allOf": [
    {
      "if": {"properties": {"production_evidence": {"const": true}}, "required": ["production_evidence"]},
      "then": {"properties": {"external_evidence_status": {"const": "VERIFIED"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "RECORD_ZONE_HEALTH"}}, "required": ["operation"]},
      "then": {"properties": {"facts": {"$ref": "#/$defs/zoneHealthFacts"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "CREATE_BACKUP"}}, "required": ["operation"]},
      "then": {"properties": {"facts": {"$ref": "#/$defs/backupFacts"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "VERIFY_RESTORE"}}, "required": ["operation"]},
      "then": {"properties": {"facts": {"$ref": "#/$defs/restoreFacts"}}}
    },
    {
      "if": {"properties": {"operation": {"enum": ["FAILOVER", "FAILBACK"]}}, "required": ["operation"]},
      "then": {"properties": {"facts": {"$ref": "#/$defs/drEventFacts"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "EXECUTE_CHAOS"}}, "required": ["operation"]},
      "then": {"properties": {"facts": {"$ref": "#/$defs/chaosFacts"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "EXECUTE_LOAD"}}, "required": ["operation"]},
      "then": {"properties": {"facts": {"$ref": "#/$defs/loadFacts"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "ROLLBACK_UPGRADE"}}, "required": ["operation"]},
      "then": {"properties": {"facts": {"$ref": "#/$defs/rollbackFacts"}}}
    }
  ],
  "$defs": {
    "uuid": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:/@-]+$"},
    "shortIdentifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:/@-]+$"},
    "resourceIdentifier": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._:/@-]+$"},
    "evidenceRef": {"type": "string", "maxLength": 2048, "pattern": "^(evidence://|urn:agenttrust:evidence:)[^\\u0000\\r\\n ?#]*$"},
    "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "evidenceRefs": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}},
    "healthMap": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}},
    "zoneHealthFacts": {
      "type": "object", "additionalProperties": false,
      "required": ["component_health", "dependency_health", "ready_replicas", "required_replicas", "topology_probe_digest", "probe_spec_digest", "observed_at"],
      "properties": {
        "component_health": {"$ref": "#/$defs/healthMap"},
        "dependency_health": {"$ref": "#/$defs/healthMap"},
        "ready_replicas": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "required_replicas": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "topology_probe_digest": {"$ref": "#/$defs/digest"},
        "probe_spec_digest": {"$ref": "#/$defs/digest"},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "backupArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "artifact_kind", "immutable_ref", "artifact_digest", "size_bytes", "encryption_key_version", "worm_locked", "evidence_ref"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/uuid"},
        "artifact_kind": {"enum": ["DATABASE", "OBJECT_MANIFEST", "LEDGER_HEAD", "KEY_RECOVERY"]},
        "immutable_ref": {"$ref": "#/$defs/resourceIdentifier"},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "size_bytes": {"$ref": "#/$defs/u64"},
        "encryption_key_version": {"$ref": "#/$defs/shortIdentifier"},
        "worm_locked": {"const": true},
        "evidence_ref": {"$ref": "#/$defs/evidenceRef"}
      }
    },
    "backupArtifacts": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": {"$ref": "#/$defs/backupArtifact"},
      "allOf": [
        {"contains": {"properties": {"artifact_kind": {"const": "DATABASE"}}, "required": ["artifact_kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"artifact_kind": {"const": "OBJECT_MANIFEST"}}, "required": ["artifact_kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"artifact_kind": {"const": "LEDGER_HEAD"}}, "required": ["artifact_kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"artifact_kind": {"const": "KEY_RECOVERY"}}, "required": ["artifact_kind"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "backupFacts": {
      "type": "object", "additionalProperties": false,
      "required": ["database_lsn", "database_artifact_digest", "object_manifest_digest", "ledger_head_digest", "worm_retention_until", "key_recovery_evidence_ref", "record_counts", "manifest_digest", "signature_key_id", "signature", "artifacts"],
      "properties": {
        "database_lsn": {"$ref": "#/$defs/identifier"},
        "database_artifact_digest": {"$ref": "#/$defs/digest"},
        "object_manifest_digest": {"$ref": "#/$defs/digest"},
        "ledger_head_digest": {"$ref": "#/$defs/digest"},
        "worm_retention_until": {"type": "string", "format": "date-time"},
        "key_recovery_evidence_ref": {"$ref": "#/$defs/evidenceRef"},
        "record_counts": {"type": "object"},
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "signature_key_id": {"$ref": "#/$defs/shortIdentifier"},
        "signature": {"type": "string", "minLength": 64, "maxLength": 1024},
        "artifacts": {"$ref": "#/$defs/backupArtifacts"}
      }
    },
    "restoreFacts": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_record_counts", "restored_record_counts", "object_integrity_passed", "ledger_reconciled", "key_recovery_passed", "measured_rto_seconds", "measured_rpo_seconds", "report_digest", "command_digest", "started_at", "completed_at"],
      "properties": {
        "expected_record_counts": {"type": "object"},
        "restored_record_counts": {"type": "object"},
        "object_integrity_passed": {"type": "boolean"},
        "ledger_reconciled": {"type": "boolean"},
        "key_recovery_passed": {"type": "boolean"},
        "measured_rto_seconds": {"$ref": "#/$defs/u64"},
        "measured_rpo_seconds": {"$ref": "#/$defs/u64"},
        "report_digest": {"$ref": "#/$defs/digest"},
        "command_digest": {"$ref": "#/$defs/digest"},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"}
      }
    },
    "drEventFacts": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter_receipt_digest", "health_evidence_ref", "measured_rto_seconds", "measured_rpo_seconds", "succeeded"],
      "properties": {
        "adapter_receipt_digest": {"$ref": "#/$defs/digest"},
        "health_evidence_ref": {"$ref": "#/$defs/evidenceRef"},
        "measured_rto_seconds": {"$ref": "#/$defs/u64"},
        "measured_rpo_seconds": {"$ref": "#/$defs/u64"},
        "succeeded": {"type": "boolean"}
      }
    },
    "chaosFacts": {
      "type": "object", "additionalProperties": false,
      "required": ["started_at", "completed_at", "safety_abort_triggered", "cleanup_verified", "dependency_failure_semantics_verified", "emergency_stop_verified", "command_digest", "report_digest", "evidence_refs"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "safety_abort_triggered": {"type": "boolean"},
        "cleanup_verified": {"type": "boolean"},
        "dependency_failure_semantics_verified": {"type": "boolean"},
        "emergency_stop_verified": {"type": "boolean"},
        "command_digest": {"$ref": "#/$defs/digest"},
        "report_digest": {"$ref": "#/$defs/digest"},
        "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
      }
    },
    "loadFacts": {
      "type": "object", "additionalProperties": false,
      "required": ["requests", "success_millionths", "p50_milliseconds", "p95_milliseconds", "p99_milliseconds", "throughput_millionths", "backpressure_rejections", "noisy_neighbor_isolation_passed", "report_digest", "evidence_refs", "started_at", "completed_at"],
      "properties": {
        "requests": {"type": "integer", "minimum": 1, "maximum": 10000000000},
        "success_millionths": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "p50_milliseconds": {"$ref": "#/$defs/u64"},
        "p95_milliseconds": {"$ref": "#/$defs/u64"},
        "p99_milliseconds": {"$ref": "#/$defs/u64"},
        "throughput_millionths": {"$ref": "#/$defs/u64"},
        "backpressure_rejections": {"$ref": "#/$defs/u64"},
        "noisy_neighbor_isolation_passed": {"type": "boolean"},
        "report_digest": {"$ref": "#/$defs/digest"},
        "evidence_refs": {"$ref": "#/$defs/evidenceRefs"},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"}
      }
    },
    "rollbackFacts": {
      "type": "object", "additionalProperties": false,
      "required": ["rollback_artifact_digest", "succeeded"],
      "properties": {
        "rollback_artifact_digest": {"$ref": "#/$defs/digest"},
        "succeeded": {"type": "boolean"}
      }
    }
  }
}
