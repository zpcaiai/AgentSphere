{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/policy-admin/policy-bundle.schema.json",
  "title": "Immutable Ed25519 Policy Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "tenant_id", "policy_id", "source_revision", "version", "source_digest", "bundle_digest", "rules", "default_decision", "review_ids", "key_id", "signature", "compiled_at"],
  "properties": {
    "schema_version": {"const": "agenttrust.signed-policy-bundle.v1"},
    "bundle_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "policy_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_revision": {"type": "integer", "minimum": 1},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_digest": {"$ref": "#/$defs/digest"},
    "bundle_digest": {"$ref": "#/$defs/digest"},
    "rules": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/rule"}},
    "default_decision": {"enum": ["DENY", "KILL", "PAUSE", "REQUIRE_APPROVAL"]},
    "review_ids": {"type": "array", "minItems": 2, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "key_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,128}$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"},
    "compiled_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "subject_pattern", "tool_pattern", "resource_pattern", "decision", "maximum_risk", "reason_code"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "subject_pattern": {"type": "string", "minLength": 1, "maxLength": 1024},
        "tool_pattern": {"type": "string", "minLength": 1, "maxLength": 1024},
        "resource_pattern": {"type": "string", "minLength": 1, "maxLength": 2048},
        "decision": {"enum": ["ALLOW", "DENY", "KILL", "PAUSE", "REQUIRE_APPROVAL"]},
        "maximum_risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"}
      }
    }
  }
}
