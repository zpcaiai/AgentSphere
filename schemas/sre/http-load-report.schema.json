{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsphere.local/schemas/sre/http-load-report.schema.json",
  "title": "Bounded HTTP load report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_reference", "requests", "concurrency", "expected_status", "status_counts", "success_ratio", "latency_ms", "throughput_requests_per_second", "thresholds", "passed", "started_at", "completed_at", "production_evidence", "evidence_digest"],
  "properties": {
    "schema_version": {"const": "agenttrust.http-load-report.v1"},
    "target_reference": {"type": "string", "minLength": 1, "maxLength": 512},
    "requests": {"type": "integer", "minimum": 1, "maximum": 100000},
    "concurrency": {"type": "integer", "minimum": 1, "maximum": 512},
    "expected_status": {"type": "integer", "minimum": 100, "maximum": 599},
    "method": {"enum": ["GET", "POST"]},
    "request_header_names": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}},
    "secret_header_names": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}},
    "request_body_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status_counts": {"type": "object", "minProperties": 1},
    "success_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "latency_ms": {"type": "object", "required": ["p50", "p95", "p99", "maximum"]},
    "throughput_requests_per_second": {"type": "number", "minimum": 0},
    "sustained_duration_seconds": {"type": ["number", "null"], "minimum": 1, "maximum": 86400},
    "observed_duration_seconds": {"type": "number", "minimum": 0},
    "sustained_duration_met": {"type": "boolean"},
    "thresholds": {"type": "object", "required": ["minimum_success_ratio", "maximum_p99_ms"]},
    "passed": {"type": "boolean"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "production_evidence": {"const": false},
    "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
