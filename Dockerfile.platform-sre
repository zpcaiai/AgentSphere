# syntax=docker/dockerfile:1.7
ARG RUST_BUILDER_IMAGE
ARG RUNTIME_BASE_IMAGE
FROM ${RUST_BUILDER_IMAGE} AS build
WORKDIR /workspace
COPY Cargo.toml Cargo.lock ./
COPY rust ./rust
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/workspace/target,sharing=locked \
    cargo build --locked --release -p agent-trust-platform-sre \
      --bin agenttrust-platform-sre-service && \
    install -D -m 0555 /workspace/target/release/agenttrust-platform-sre-service \
      /out/agenttrust-platform-sre-service

FROM ${RUNTIME_BASE_IMAGE}
COPY --from=build /out/agenttrust-platform-sre-service /usr/local/bin/agenttrust-platform-sre-service
USER 65532:65532
EXPOSE 8097 9107
ENTRYPOINT ["/usr/local/bin/agenttrust-platform-sre-service"]
