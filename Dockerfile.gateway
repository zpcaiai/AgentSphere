FROM rust:1.89-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --locked --release -p agent-trust-gateway

FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=build /src/target/release/agent-trust-gateway /usr/local/bin/agent-trust-gateway
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/agent-trust-gateway"]
